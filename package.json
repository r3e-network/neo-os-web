{
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "platform/*"
  ],
  "scripts": {
    "test": "npm run -s test:host-app && npm run -s test:admin-console",
    "test:go": "node -e \"console.log('Legacy Go service layer moved to external repos; root Go test suite is no longer part of neo-miniapps-platform.')\"",
    "test:testnet:direct": "bash deploy/scripts/verify_cross_repo_testnet.sh",
    "test:flagship-miniapps": "node deploy/scripts/audit_flagship_miniapps.js",
    "test:flagship-deployed-abi": "node deploy/scripts/audit_flagship_deployed_abi.js",
    "test:flagship-testnet-state": "node deploy/scripts/verify_flagship_testnet_state.js",
    "test:flagship-update-dryrun": "bash -c 'set -a; . ./.env; set +a; go run -tags=scripts deploy/scripts/update_flagship_testnet_contracts.go'",
    "test:host-app": "npm --prefix platform/host-app test --silent",
    "test:admin-console": "npm --prefix platform/admin-console run -s test -- --run",
    "backfill:miniapp-versions": "node deploy/scripts/backfill-miniapp-versions.js",
    "verify:publish-audit-chain": "node deploy/scripts/verify-publish-audit-chain.js",
    "validate:miniapp-env": "node deploy/scripts/validate-miniapp-env.js"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "turbo": "^2.8.11",
    "vite-plugin-node-polyfills": "^0.25.0"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "jspdf": "^4.2.0",
    "qrcode": "^1.5.4",
    "sass": "^1.98.0",
    "vue": "^3.5.30"
  }
}
