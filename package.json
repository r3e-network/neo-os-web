{
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "platform/*"
  ],
  "scripts": {
    "verify:repo": "bash scripts/verify_repo.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:repo:lint-scope": "node deploy/scripts/audit_lint_scope.mjs",
    "check:repo:lint-scope": "node deploy/scripts/audit_lint_scope.mjs --check",
    "audit:repo:secret-material": "node deploy/scripts/audit_secret_material.mjs",
    "check:repo:secret-material": "node deploy/scripts/audit_secret_material.mjs --check",
    "test": "fail=0; for s in deploy-scripts host-app admin-console; do npm run -s test:$s || fail=1; done; exit $fail",
    "test:validation": "cd tests && npx vitest run",
    "test:validation:watch": "cd tests && npx vitest",
    "test:go": "node -e \"console.log('Legacy Go service layer moved to external repos; root Go test suite is no longer part of neo-os-web.')\"",
    "test:testnet:local-gates": "bash deploy/scripts/run_local_validation_gates.sh",
    "test:testnet:live": "bash deploy/scripts/run_live_testnet_validation.sh",
    "test:testnet:live:smoke": "bash deploy/scripts/run_full_live_smoke.sh",
    "test:testnet:live:smoke:flagship": "bash deploy/scripts/run_full_live_smoke.sh --flagship-only",
    "test:testnet:live:smoke:selected": "bash deploy/scripts/run_full_live_smoke.sh --selected-only",
    "test:testnet:live:direct-only": "bash deploy/scripts/run_live_testnet_validation.sh --direct-only",
    "test:testnet:direct": "bash deploy/scripts/verify_cross_repo_testnet.sh",
    "test:testnet:full-stack": "bash deploy/scripts/run_full_stack_testnet_validation.sh",
    "test:flagship-miniapps": "node deploy/scripts/audit_flagship_miniapps.js",
    "test:flagship-deployed-abi": "node deploy/scripts/audit_flagship_deployed_abi.js",
    "test:flagship-active-state": "node deploy/scripts/verify_flagship_active_state.js",
    "test:mainnet:miniapp-contract-methods": "node deploy/scripts/verify_mainnet_miniapp_contract_methods.js",
    "test:flagship-live-user-flows": "node deploy/scripts/live_validate_flagship_user_flows.js",
    "test:miniapp-deploy-dryrun": "bash -c 'set -a; . ./.env; set +a; go run -tags=scripts deploy/scripts/deploy_selected_miniapp_contracts.go'",
    "update:miniapp-contracts": "go run -tags=scripts deploy/scripts/update_miniapp_contracts.go",
    "audit:miniapps:coverage": "node deploy/scripts/audit_all_miniapp_coverage.js",
    "audit:miniapps:live-harness": "node deploy/scripts/audit_live_harness_coverage.js",
    "audit:miniapps:playareas": "node deploy/scripts/audit_miniapp_playarea_functionality.js",
    "audit:miniapps:media": "node deploy/scripts/audit_miniapp_media_identity.js",
    "audit:contract-domains": "node deploy/scripts/audit_contract_domains.js --fail-on-config-missing",
    "audit:contract-domains:strict": "node deploy/scripts/audit_contract_domains.js --strict",
    "bind:contract-domains": "node deploy/scripts/bind_contract_domains.js",
    "bind:contract-domains:execute": "node deploy/scripts/bind_contract_domains.js --execute",
    "audit:miniapps:layout": "node deploy/scripts/verify_miniapp_layout_consistency.js",
    "audit:platform:testnet-live": "node deploy/scripts/verify_platform_contracts_live.mjs",
    "audit:platform:game-live-state": "node deploy/scripts/audit_platform_game_live_state.mjs",
    "audit:platform:social-framework": "node deploy/scripts/audit_platform_social_framework.mjs",
    "check:platform:social-framework": "node deploy/scripts/audit_platform_social_framework.mjs --check",
    "audit:platform:anchor-framework": "node deploy/scripts/audit_platform_anchor_framework.mjs",
    "check:platform:anchor-framework": "node deploy/scripts/audit_platform_anchor_framework.mjs --check",
    "audit:platform:registry-framework": "node deploy/scripts/audit_platform_registry_framework.mjs",
    "check:platform:registry-framework": "node deploy/scripts/audit_platform_registry_framework.mjs --check",
    "audit:platform:defi-framework": "node deploy/scripts/audit_platform_defi_framework.mjs",
    "audit:platform:defi-legacy-credits": "node deploy/scripts/audit_platform_defi_legacy_credits.mjs",
    "check:platform:defi-framework": "node deploy/scripts/audit_platform_defi_framework.mjs --check",
    "audit:platform:factory-framework": "node deploy/scripts/audit_platform_factory_framework.mjs",
    "check:platform:factory-framework": "node deploy/scripts/audit_platform_factory_framework.mjs --check",
    "audit:platform:vesting-framework": "node deploy/scripts/audit_platform_vesting_framework.mjs",
    "check:platform:vesting-framework": "node deploy/scripts/audit_platform_vesting_framework.mjs --check",
    "audit:platform:escrow-framework": "node deploy/scripts/audit_platform_escrow_framework.mjs",
    "check:platform:escrow-framework": "node deploy/scripts/audit_platform_escrow_framework.mjs --check",
    "audit:platform:shared-aa-preflight": "node deploy/scripts/audit_shared_aa_upgrade_preflight.mjs",
    "audit:platform:shared-aa-governance": "PLATFORM_SHARED_AA_ACTION=status go run -tags=scripts deploy/scripts/configure_shared_aa_testnet.go",
    "audit:platform:shared-aa-roster": "node deploy/scripts/audit_shared_aa_account_roster.mjs",
    "check:platform:shared-aa-roster": "node deploy/scripts/audit_shared_aa_account_roster.mjs --check",
    "audit:cross-repo:duplication": "node deploy/scripts/audit_cross_repo_duplication.mjs",
    "check:cross-repo:duplication": "node deploy/scripts/audit_cross_repo_duplication.mjs --check",
    "generate:factory-template-artifacts": "node deploy/scripts/generate_factory_template_artifacts.mjs",
    "check:factory-template-artifacts": "node deploy/scripts/generate_factory_template_artifacts.mjs --check",
    "test:host-app": "npm --prefix platform/host-app test --silent",
    "test:host-app:full": "npm --workspace platform/host-app run test:full",
    "test:host-app:surface": "npm --prefix platform/host-app run test:e2e:surface",
    "test:admin-console": "npm --prefix platform/admin-console test --silent",
    "test:deploy-scripts": "node --test deploy/scripts/lib/*.test.mjs",
    "test:shared-aa-governance": "go test -tags=scripts ./deploy/scripts/configure_shared_aa_testnet.go ./deploy/scripts/configure_shared_aa_testnet_test.go -count=1",
    "build:contracts": "bash contracts/build.sh",
    "test:contracts": "bash -c 'source deploy/scripts/lib/dotnet_tools.sh && ensure_dotnet_root && dotnet test contracts/__tests__'",
    "test:contracts:full": "BUILD_LEGACY_CLONES=1 npm run -s build:contracts && npm run -s test:contracts",
    "backfill:miniapp-versions": "node deploy/scripts/backfill-miniapp-versions.js",
    "verify:publish-audit-chain": "node deploy/scripts/verify-publish-audit-chain.js",
    "validate:miniapp-env": "node deploy/scripts/validate-miniapp-env.js",
    "test:integration": "node --test test/integration/*.test.mjs",
    "fuzz": "node test/fuzz/run_all.mjs",
    "fuzz:reads": "node test/fuzz/fuzz_contract_reads.mjs",
    "fuzz:writes": "node test/fuzz/fuzz_contract_writes.mjs",
    "fuzz:cross": "node test/fuzz/fuzz_cross_repo.mjs",
    "fuzz:continuous": "FUZZ_CONTINUOUS=1 node test/fuzz/run_all.mjs",
    "sim:multiuser": "node test/fuzz/multi_user_business_sim.mjs",
    "sim:multiuser:once": "SIM_ITERATIONS=1 node test/fuzz/multi_user_business_sim.mjs",
    "verify:miniapp-dapps": "node scripts/verify-miniapp-dapp-support.mjs",
    "verify:onegate:mock": "node scripts/verify-onegate-miniapp-loads.mjs",
    "build:miniapp-dapps": "node scripts/build-miniapp-dapps.mjs",
    "export:miniapp-dapps": "npm run -s verify:miniapp-dapps && npm run -s build:miniapp-dapps && npm run -s stage:miniapps:dist",
    "assets:miniapps:optimize": "node scripts/optimize-miniapp-assets.mjs",
    "stage:miniapps:dist": "node scripts/stage-miniapp-dists.mjs",
    "audit:platform:game-surface": "node deploy/scripts/audit_platform_game_surface.mjs"
  },
  "devDependencies": {
    "@cityofzion/neon-js": "^5.9.0",
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turbo": "^2.9.14",
    "typescript-eslint": "^8.61.0",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.1.0",
    "vue": "^3.5.33"
  },
  "dependencies": {
    "@douyinfe/semi-ui": "^2.101.0",
    "@r3e/neo-js-sdk": "https://codeload.github.com/r3e-network/neo-js-sdk/tar.gz/refs/tags/v0.3.7-r3e.1",
    "@types/qrcode": "^1.5.6",
    "jspdf": "^4.2.1",
    "phaser": "^3.90.0",
    "puppeteer-core": "^25.3.0",
    "qrcode": "^1.5.4",
    "sass": "^1.98.0"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "fast-xml-parser": "5.5.8",
    "serialize-javascript": "7.0.4",
    "socket.io-parser": "4.2.6",
    "axios": "1.18.1",
    "follow-redirects": "1.16.0",
    "dompurify": "3.4.12",
    "immutable": "5.1.9",
    "sharp": "0.35.3",
    "minimatch@>=9": {
      "brace-expansion": "5.0.8"
    },
    "minimatch@<9": {
      "brace-expansion": "1.1.16"
    },
    "protobufjs": "7.5.8",
    "picomatch": "4.0.4",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "next": {
      "postcss": "8.5.23"
    },
    "postcss": "8.5.23",
    "lodash": "4.18.1",
    "ws": "8.21.0"
  }
}
