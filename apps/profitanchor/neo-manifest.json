{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-profitanchor",
  "name": "ProfitAnchor",
  "name_zh": "收益锚",
  "version": "2.0.0",
  "description": "Yield-maximizing NEO staking: your NEO is voted by 21 anchor agents under a profit policy, and the GAS those votes earn is split pro-rata to stakers (variable, no fixed APR). A distinct pool from TrustAnchor; its route is readable by SelfLoan without ceding custody. Manual 21-agent AA routing is handled in ProfitAnchor Admin.",
  "description_zh": "收益优先的 NEO 质押：你的 NEO 由 21 个锚点 agent 按收益策略投票，投票产生的 GAS 按比例分配给质押者（浮动，无固定 APR）。与 TrustAnchor 独立的资金池，其路由可被 SelfLoan 读取且无需转移托管权。21 个 AA agent 的手动调仓由 ProfitAnchor Admin 处理。",
  "category": "defi",
  "category_name": "DeFi",
  "category_name_zh": "去中心化金融",
  "tags": [
    "staking",
    "voting",
    "gas-yield",
    "profit",
    "aa"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0x02beeef6f65c6989a121c0a0e6b23190333edb98",
    "neo-n3-testnet": "0xab079b4f9a0a2471d136392e25eb8e99898dcad0"
  },
  "contract_domains": {
    "neo-n3-mainnet": "profitanchor.miniapp.neo"
  },
  "runtime": {
    "mode": "platform",
    "modules": [
      {
        "binding": "anchor-staking",
        "platform": "PlatformAnchor",
        "appId": "miniapp-profitanchor",
        "moduleType": 2,
        "registration": {
          "method": "registerAnchorApp",
          "type": 2
        },
        "operations": {
          "stake": "stake",
          "withdraw": "withdraw",
          "claimRewards": "claimRewards",
          "stats": "getAnchorStats"
        },
        "networks": {
          "neo-n3-mainnet": {
            "contract_hash": "0x02beeef6f65c6989a121c0a0e6b23190333edb98",
            "registered": true
          },
          "neo-n3-testnet": {
            "contract_hash": "0xab079b4f9a0a2471d136392e25eb8e99898dcad0",
            "registered": true
          }
        }
      }
    ]
  },
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
