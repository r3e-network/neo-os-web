{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-oracle-price-console",
  "name": "Oracle Price Console",
  "name_zh": "预言机价格台",
  "version": "1.0.0",
  "description": "Query the Morpheus price feed from a dedicated miniapp console.",
  "description_zh": "用独立小程序控制台查询 Morpheus 价格源。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [
    "oracle",
    "price",
    "feed",
    "morpheus"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-testnet",
  "urls": {
    "entry": "/miniapps/oracle-price-console/index.html",
    "icon": "/miniapps/oracle-price-console/logo.jpg",
    "banner": "/miniapps/oracle-price-console/banner.jpg"
  },
  "permissions": [
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://oracle-price-console"
  },
  "stateSource": {
    "type": "api",
    "chain": "neo-n3-testnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "operation_panel": {
    "title": "Price Feed",
    "subtitle": "Select a feed symbol from the action console and verify the request package in the playarea.",
    "operations": [
      {
        "name": "Build Feed Request",
        "method": "buildOraclePackage",
        "description": "Prepare a Morpheus price-feed request package.",
        "button_style": "secondary",
        "params": [
          {
            "name": "symbol",
            "type": "string",
            "label": "Feed symbol",
            "placeholder": "TWELVEDATA:NEO-USD",
            "default_value": "TWELVEDATA:NEO-USD",
            "required": true
          }
        ]
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": false
  },
  "createdAt": "2026-03-18T05:00:00Z",
  "updatedAt": "2026-03-18T05:00:00Z"
}
