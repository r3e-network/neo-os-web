{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-burn-league",
  "name": "Burn League",
  "name_zh": "燃烧联赛",
  "version": "1.0.0",
  "description": "Compete in token burning challenges and climb the leaderboard",
  "description_zh": "燃烧竞技联赛 — 参与代币燃烧挑战赛，登上排行榜争夺荣耀",
  "category": "games",
  "category_name": "Games",
  "category_name_zh": "游戏",
  "tags": [
    "burn",
    "competition",
    "leaderboard"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0xd829b7a8c0d9fa3c67a29c703a277de3f922f173",
    "neo-n3-testnet": "0x0946e3c3db8abdd2fa14bbae4978992015473c09"
  },
  "contract_domains": {
    "neo-n3-mainnet": "burnleague.miniapp.neo"
  },
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/burn-league/index.html",
    "icon": "/miniapps/burn-league/logo.jpg",
    "banner": "/miniapps/burn-league/banner.jpg"
  },
  "permissions": [
    "invoke:primary",
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://burn-league"
  },
  "operation_panel": {
    "title": "Burn League",
    "subtitle": "Set a GAS burn amount, open the live desk, then confirm the OS wallet intent inside the MiniApp.",
    "operations": [
      {
        "name": "Prepare Burn Entry",
        "method": "prepareMiniAppOperation",
        "description": "Pre-fill the burn amount and open the embedded Burn League desk. Submit Burn Now inside the live dApp after reviewing the rank and reward preview.",
        "button_style": "danger",
        "priority": "primary",
        "params": [
          {
            "name": "amount",
            "type": "amount",
            "label": "Burn amount",
            "required": true,
            "default_value": "1",
            "placeholder": "1",
            "scale": 8,
            "presets": [
              {
                "label": "1",
                "value": "1",
                "helper": "GAS"
              },
              {
                "label": "5",
                "value": "5",
                "helper": "GAS"
              },
              {
                "label": "10",
                "value": "10",
                "helper": "GAS"
              }
            ]
          }
        ]
      }
    ]
  },
  "stateSource": {
    "type": "n3index",
    "chain": "neo-n3-mainnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-06-01T00:00:00Z"
}
