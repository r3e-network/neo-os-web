{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-self-loan",
  "name": "SelfLoan",
  "name_zh": "自我借贷",
  "version": "2.0.0",
  "description": "Lock NEO to borrow GAS upfront against future staking rewards. Collateral can follow ProfitAnchor's best-profit vote signal while staying in SelfLoan custody.",
  "description_zh": "自我借贷 — 锁定 NEO 预借 GAS，抵押品可跟随 ProfitAnchor 的最佳收益投票信号，同时仍由 SelfLoan 托管。",
  "category": "finance",
  "category_name": "Finance",
  "category_name_zh": "金融",
  "tags": [
    "lending",
    "defi",
    "collateral",
    "self-loan",
    "neo",
    "profitanchor"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0x942da575b31f39cbb59e64b5813b128739b44c25",
    "neo-n3-testnet": "0xb43bd0ded09b5d79ed858484106affc1c858483c"
  },
  "contract_domains": {
    "neo-n3-mainnet": "selfloan.miniapp.neo"
  },
  "runtime": {
    "mode": "platform",
    "modules": [
      {
        "binding": "collateralized-loan",
        "platform": "PlatformDeFi",
        "appId": "miniapp-self-loan",
        "moduleType": 1,
        "registration": {
          "method": "registerProduct",
          "type": 1
        },
        "operations": {
          "create_loan": "createLoan",
          "repay": "repayLoan",
          "add_collateral": "addCollateral"
        },
        "networks": {
          "neo-n3-mainnet": {
            "contract_hash": "0x942da575b31f39cbb59e64b5813b128739b44c25",
            "registered": true,
            "domain": "selfloan.miniapp.neo"
          },
          "neo-n3-testnet": {
            "contract_hash": "0xb43bd0ded09b5d79ed858484106affc1c858483c",
            "registered": true
          }
        }
      }
    ]
  },
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/self-loan/index.html",
    "icon": "/miniapps/self-loan/logo.jpg",
    "banner": "/miniapps/self-loan/banner.jpg"
  },
  "permissions": [
    "invoke:primary",
    "read:blockchain",
    "governance:vote"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://self-loan"
  },
  "stateSource": {
    "type": "n3index",
    "chain": "neo-n3-mainnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-05-02T00:00:00Z",
  "featured": true,
  "featured_order": 1,
  "technologies": {
    "keeper": {
      "enabled": true,
      "description": "Auto-monitors health factor and triggers alerts",
      "conditions": [
        "health_factor_threshold"
      ]
    },
    "profitAnchor": {
      "enabled": true,
      "dependency": "miniapp-profitanchor",
      "description": "Reads ProfitAnchor best-candidate routing and votes collateralized NEO from SelfLoan custody."
    }
  }
}
