{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-fogplay",
  "name": "FogPlay",
  "name_zh": "迷雾对决",
  "version": "2.0.0",
  "description": "Fast oracle-backed coin flips on Neo N3. Pick heads or tails, place a GAS wager, and wait for the on-chain callback to settle the round.",
  "description_zh": "迷雾对决是一款基于预言机回调的 Neo N3 链上猜硬币游戏。选择正面或反面、下注 GAS，并等待链上回调完成结算。",
  "category": "games",
  "category_name": "Games",
  "category_name_zh": "游戏",
  "tags": [
    "fogplay",
    "gambling",
    "randomness",
    "oracle",
    "betting"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0xa7840a8d5404bbe297a00756a29cc267d6fa6cc7",
    "neo-n3-testnet": "0x740671b10330ef6669ab8b2724437eb8d5e7a34c"
  },
  "contract_domains": {
    "neo-n3-mainnet": "fogplay.miniapp.neo"
  },
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/fogplay/index.html",
    "icon": "/miniapps/fogplay/logo.jpg",
    "banner": "/miniapps/fogplay/banner.jpg"
  },
  "permissions": [
    "invoke:primary",
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://fogplay"
  },
  "stateSource": {
    "type": "n3index",
    "chain": "neo-n3-mainnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-05-08T13:07:29Z",
  "featured": true,
  "featured_order": 3,
  "technologies": {
    "oracle": {
      "enabled": true,
      "description": "Morpheus Oracle randomness callbacks settle each flip on-chain"
    },
    "aa": {
      "enabled": false,
      "description": "AA rapid-play integration is planned but is not the live testnet flow"
    },
    "tee": {
      "enabled": false,
      "description": "The live product is single-player user-versus-system coin flip; PvP TEE duel mode is not enabled"
    }
  },
  "runtime": {
    "mode": "platform",
    "modules": [
      {
        "binding": "coin-flip",
        "platform": "PlatformGame",
        "appId": "miniapp-fogplay",
        "moduleType": 2,
        "registration": {
          "method": "registerGame",
          "type": 2
        },
        "operations": {
          "place_bet": "placeCoinFlipBet",
          "limits": "getCoinFlipBetLimits",
          "bet": "getCoinFlipBet"
        },
        "networks": {
          "neo-n3-mainnet": {
            "contract_hash": "0xa7840a8d5404bbe297a00756a29cc267d6fa6cc7",
            "registered": true,
            "domain": "fogplay.miniapp.neo"
          },
          "neo-n3-testnet": {
            "contract_hash": "0x740671b10330ef6669ab8b2724437eb8d5e7a34c",
