{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-fogplay",
  "name": "FogPlay",
  "name_zh": "迷雾对决",
  "version": "2.0.0",
  "description": "Provably-fair on-chain coin flip on Neo N3. Pick heads or tails (50% chance) and place a GAS wager — your bet commits first, then the outcome is revealed from a later block's native randomness and pays 2x, so the result can't be peeked or aborted on a loss.",
  "description_zh": "Neo N3 上可证明公平的链上抛硬币游戏。选择正面或反面（50% 胜率）并下注 GAS——下注先行提交，随后由更晚区块的原生随机数揭晓结果并支付 2 倍赔付，结果无法被窥探或在将输时中止。",
  "category": "games",
  "category_name": "Games",
  "category_name_zh": "游戏",
  "tags": [
    "fogplay",
    "gambling",
    "randomness",
    "betting"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0x611c3d97dd98792a3c31a0e695704c657f143cda",
    "neo-n3-testnet": "0x611c3d97dd98792a3c31a0e695704c657f143cda"
  },
  "contract_domains": {
    "neo-n3-mainnet": "fogplay.miniapp.neo"
  },
