{
  "extends": "../tsconfig.miniapp.react.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@framework/*": ["../../framework/*"],
      "@shared/*": ["../shared/*"]
    },
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
