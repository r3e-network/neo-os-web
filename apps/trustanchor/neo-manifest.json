{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-trustanchor",
  "name": "TrustAnchor",
  "name_zh": "信任锚点",
  "version": "2.0.0",
  "description": "Governance-aligned NEO staking: your NEO is voted by 21 anchor agents toward council stability, and the GAS those votes earn is split pro-rata to stakers (variable, no fixed APR). A distinct pool from the yield-maximizing ProfitAnchor. Manual 21-agent AA routing is handled in TrustAnchor Admin.",
  "description_zh": "治理优先的 NEO 质押：你的 NEO 由 21 个锚点 agent 投票以维护 council 稳定，投票产生的 GAS 按比例分配给质押者（浮动，无固定 APR）。与收益优先的 ProfitAnchor 独立的资金池。21 个 AA agent 的手动调仓由 TrustAnchor Admin 处理。",
  "category": "governance",
  "category_name": "Governance",
  "category_name_zh": "治理",
  "tags": [
    "staking",
    "voting",
    "governance",
    "aa",
    "zero-fee"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0x02beeef6f65c6989a121c0a0e6b23190333edb98",
    "neo-n3-testnet": "0xab079b4f9a0a2471d136392e25eb8e99898dcad0"
  },
  "contract_domains": {
    "neo-n3-mainnet": "trustanchor.miniapp.neo"
  },
  "runtime": {
    "mode": "platform",
    "modules": [
      {
        "binding": "anchor-staking",
        "platform": "PlatformAnchor",
        "appId": "miniapp-trustanchor",
        "moduleType": 1,
        "registration": {
          "method": "registerAnchorApp",
          "type": 1
        },
        "operations": {
          "stake": "stake",
          "withdraw": "withdraw",
          "claimRewards": "claimRewards",
          "stats": "getAnchorStats"
        },
        "networks": {
          "neo-n3-mainnet": {
            "contract_hash": "0x02beeef6f65c6989a121c0a0e6b23190333edb98",
            "registered": true
          },
          "neo-n3-testnet": {
            "contract_hash": "0xab079b4f9a0a2471d136392e25eb8e99898dcad0",
            "registered": true
          }
        }
      }
    ]
  },
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
