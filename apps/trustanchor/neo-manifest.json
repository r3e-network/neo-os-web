{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-trustanchor",
  "name": "TrustAnchor",
  "name_zh": "信任锚点",
  "version": "1.0.0",
  "description": "AA-agent NEO staking and governance routing where admins can register agents and sync votes, but cannot transfer user stake or reward GAS.",
  "description_zh": "信任锚 — 使用 AA agent 账户进行 NEO 质押和治理路由；管理员只能注册 agent 并同步投票，不能转移用户质押或奖励 GAS。",
  "category": "governance",
  "category_name": "Governance",
  "category_name_zh": "治理",
  "tags": [
    "staking",
    "voting",
    "governance",
    "aa",
    "zero-fee"
  ],
  "developer": {
    "name": "R3E Network",
    "email": "dev@r3e.network",
    "website": "https://r3e.network"
  },
  "contracts": {
    "neo-n3-mainnet": "0xa1ca7a610105686635f31de8e174ae3ce6b61a3e",
    "neo-n3-testnet": "0xa1ca7a610105686635f31de8e174ae3ce6b61a3e"
  },
  "contract_domains": {
    "neo-n3-mainnet": "trustanchor.miniapp.neo"
  },
  "runtime": {
    "mode": "platform",
    "modules": [
      {
        "binding": "anchor-staking",
        "platform": "PlatformAnchor",
        "appId": "miniapp-trustanchor",
        "moduleType": 1,
        "registration": {
          "method": "registerAnchorApp",
          "type": 1
        },
        "operations": {
          "stake": "stake",
          "withdraw": "withdraw",
          "claim": "claimRewards",
          "stats": "getAnchorStats"
        },
        "networks": {
          "neo-n3-mainnet": {
            "contract_hash": "0xa1ca7a610105686635f31de8e174ae3ce6b61a3e",
            "registered": true
          },
          "neo-n3-testnet": {
            "contract_hash": "0xa1ca7a610105686635f31de8e174ae3ce6b61a3e",
            "registered": true
          }
        }
      }
    ]
  },
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/trustanchor/index.html",
    "icon": "/miniapps/trustanchor/logo.jpg",
    "banner": "/miniapps/trustanchor/banner.jpg"
  },
  "permissions": [
    "invoke:primary",
    "read:blockchain",
    "aa:agent",
    "governance:vote"
  ],
  "features": {
    "stateless": false,
    "offlineSupport": false,
    "deeplink": "neomainapp://trustanchor"
  },
  "stateSource": {
    "type": "n3index",
    "chain": "neo-n3-mainnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-05-05T00:00:00Z"
}
