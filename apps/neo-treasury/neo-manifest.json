{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-neo-treasury",
  "name": "Neo Treasury",
  "name_zh": "Neo 财库",
  "version": "1.0.0",
  "description": "Track public Neo treasury balances and submit controlled connected-wallet NEO/GAS disbursements.",
  "description_zh": "追踪 Neo 国库公开余额，并从已连接钱包提交受控 NEO/GAS 支出。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/neo-treasury/index.html",
    "icon": "/miniapps/neo-treasury/logo.jpg",
    "banner": "/miniapps/neo-treasury/banner.jpg"
  },
  "permissions": [
    "invoke:primary",
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://neo-treasury"
  },
  "stateSource": {
    "type": "chain",
    "chain": "neo-n3-mainnet",
    "endpoints": [
      "https://mainnet2.neo.coz.io:443",
      "https://mainnet3.neo.coz.io:443",
      "https://mainnet4.neo.coz.io:443",
      "https://mainnet5.neo.coz.io:443",
      "https://rpc10.n3.nspcc.ru:10331"
    ]
  },
  "operation_panel": {
    "title": "Treasury Operations",
    "subtitle": "Review public balances, then submit a connected-wallet NEP-17 disbursement without claiming control over watched foundation wallets.",
    "operations": [
      {
        "name": "Sign Disbursement",
        "method": "submitDisbursement",
        "description": "Transfer NEO or GAS from the connected wallet to a treasury recipient with a memo.",
        "button_style": "success",
        "priority": "primary",
        "confirm_message": "Submit this treasury disbursement from your connected wallet?",
        "params": [
          {
            "name": "asset",
            "type": "select",
            "label": "Asset",
            "required": true,
            "default_value": "GAS",
            "options": [
              "GAS",
              "NEO"
            ]
          },
          {
            "name": "amount",
            "type": "amount",
            "label": "Amount",
            "placeholder": "1",
            "required": true,
            "scale": 8,
            "presets": [
              {
                "label": "0.1",
                "value": "0.1",
                "helper": "GAS"
              },
              {
                "label": "1",
                "value": "1",
                "helper": "GAS"
              },
              {
                "label": "5",
                "value": "5",
                "helper": "GAS"
              }
            ]
          },
          {
            "name": "recipient",
            "type": "address",
            "label": "Recipient",
            "placeholder": "N...",
            "required": true
          },
          {
            "name": "memo",
            "type": "string",
            "label": "Memo",
            "placeholder": "treasury-disbursement",
            "default_value": "treasury-disbursement"
          }
        ]
      },
      {
        "name": "Refresh Treasury",
        "method": "refresh",
        "description": "Reload public watched-wallet balances from Neo N3 RPC.",
        "button_style": "secondary",
        "priority": "secondary",
        "params": []
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-06-01T00:00:00Z"
}
