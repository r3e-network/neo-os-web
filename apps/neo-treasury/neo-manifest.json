{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-neo-treasury",
  "name": "Neo Treasury",
  "name_zh": "Neo 国库",
  "version": "1.1.0",
  "description": "Monitor a public Mainnet wallet watchlist and verify direct connected-wallet NEO/GAS transfers.",
  "description_zh": "监控主网公开钱包观察清单，并核验从已连接钱包发起的 NEO/GAS 直接转账。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [
    "treasury-watchlist",
    "neo",
    "gas",
    "verified-transfer"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/neo-treasury/index.html",
    "icon": "/miniapps/neo-treasury/logo.webp",
    "banner": "/miniapps/neo-treasury/banner.webp"
  },
  "permissions": [
    "invoke:primary",
    "read:blockchain"
  ],
  "features": {
    "stateless": false,
    "offlineSupport": false,
    "deeplink": "neomainapp://neo-treasury"
  },
  "stateSource": {
    "type": "chain",
    "chain": "neo-n3-mainnet",
    "endpoints": [
      "https://mainnet2.neo.coz.io:443",
      "https://mainnet3.neo.coz.io:443",
      "https://mainnet4.neo.coz.io:443",
      "https://mainnet5.neo.coz.io:443",
      "https://rpc10.n3.nspcc.ru:10331",
      "https://api.n3index.dev"
    ]
  },
  "operation_panel": {
    "title": "Treasury Operations",
    "subtitle": "Review public Mainnet balances, then verify a native-token transfer made only from the connected wallet.",
    "operations": [
      {
        "name": "Review Native Transfer",
        "method": "submitDisbursement",
        "description": "Transfer NEO or GAS from the connected wallet; confirmation requires an exact indexed Transfer event and authoritative balance readback.",
        "button_style": "success",
        "priority": "primary",
        "confirm_message": "Review the exact network, native token contract, recipient, and amount in your wallet?",
        "params": [
          {
            "name": "asset",
            "type": "select",
            "label": "Asset",
            "required": true,
            "default_value": "GAS",
            "options": [
              "GAS",
              "NEO"
            ]
          },
          {
            "name": "amount",
            "type": "amount",
            "label": "Amount",
            "placeholder": "1",
            "required": true,
            "scale": 8,
            "presets": [
              {
                "label": "0.1",
                "value": "0.1",
                "helper": "GAS"
              },
              {
                "label": "1",
                "value": "1",
                "helper": "GAS"
              },
              {
                "label": "5",
                "value": "5",
                "helper": "GAS"
              }
            ]
          },
          {
            "name": "recipient",
            "type": "address",
            "label": "Recipient",
            "placeholder": "N...",
            "required": true
          },
          {
            "name": "memo",
            "type": "string",
            "label": "Memo",
            "placeholder": "treasury-disbursement",
            "default_value": "treasury-disbursement"
          }
        ]
      },
      {
        "name": "Refresh Treasury",
        "method": "refresh",
        "description": "Reload public watched-wallet balances from Neo N3 RPC.",
        "button_style": "secondary",
        "priority": "secondary",
        "params": []
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-07-12T00:00:00Z"
}
