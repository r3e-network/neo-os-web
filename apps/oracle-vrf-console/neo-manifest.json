    "banner": "/miniapps/oracle-vrf-console/oracle-workspace-stage.webp"
  },
  "permissions": ["read:blockchain"],
  "features": {
    "stateless": false,
    "offlineSupport": false,
    "deeplink": "neomainapp://oracle-vrf-console"
