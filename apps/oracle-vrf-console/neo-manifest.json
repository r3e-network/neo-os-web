{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-oracle-vrf-console",
  "name": "Oracle VRF Console",
  "name_zh": "预言机随机数控制台",
  "version": "1.0.0",
  "description": "Prepare Morpheus verifiable randomness requests.",
  "description_zh": "准备 Morpheus 可验证随机数请求。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [
    "oracle",
    "morpheus",
    "vrf",
    "randomness"
  ],
  "developer": {
    "name": "R3E Network",
    "email": "dev@r3e.network",
    "website": "https://r3e.network"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-testnet",
  "urls": {
    "entry": "/miniapps/oracle-vrf-console/index.html",
    "icon": "/miniapps/oracle-vrf-console/logo.jpg",
    "banner": "/miniapps/oracle-vrf-console/banner.jpg"
  },
  "permissions": [
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://oracle-vrf-console"
  },
  "stateSource": {
    "type": "api",
    "chain": "neo-n3-testnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "operation_panel": {
    "title": "VRF Request",
    "subtitle": "Prepare randomness request metadata in the action console and inspect the verifiable envelope in the playarea.",
    "operations": [
      {
        "name": "Build VRF Request",
        "method": "buildOraclePackage",
        "description": "Prepare a Morpheus VRF request package.",
        "button_style": "secondary",
        "params": [
          {
            "name": "endpoint",
            "type": "string",
            "label": "Seed / request tag",
            "placeholder": "vrf:campaign-or-game-round",
            "default_value": "vrf:miniapp-round",
            "required": true
          }
        ]
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": false
  },
  "createdAt": "2026-05-01T00:00:00Z",
  "updatedAt": "2026-05-01T00:00:00Z"
}
