{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-oracle-vrf-console",
  "name": "Oracle VRF Workbench",
  "name_zh": "预言机随机数工作台",
  "version": "1.1.0",
  "description": "Build exact Morpheus randomness request drafts, inspect live Oracle and callback bindings, and verify signed responses against the selected network's pinned worker signer. This read-only workbench never submits the protected VRF request for you.",
