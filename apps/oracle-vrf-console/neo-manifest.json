  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": ["oracle", "morpheus", "vrf", "randomness", "verification", "csprng"],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": ["neo-n3-mainnet", "neo-n3-testnet"],
  "default_network": "neo-n3-mainnet",
  "urls": {
