{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-oracle-compute-lab",
  "name": "Oracle Compute Lab",
  "name_zh": "预言机计算实验室",
  "version": "1.0.0",
  "description": "Build Morpheus compute previews that keep sealed inputs redacted.",
  "description_zh": "构建不会暴露加密封装输入的 Morpheus 计算预览。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [
    "oracle",
    "morpheus",
    "compute",
    "workflow"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-testnet",
  "urls": {
    "entry": "/miniapps/oracle-compute-lab/index.html",
    "icon": "/miniapps/oracle-compute-lab/logo.jpg",
    "banner": "/miniapps/oracle-compute-lab/banner.jpg"
  },
  "permissions": [
    "read:blockchain",
    "oracle",
    "compute",
    "confidential",
    "datafeed"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://oracle-compute-lab"
  },
  "stateSource": {
    "type": "api",
    "chain": "neo-n3-testnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "operation_panel": {
    "title": "Compute Preview",
    "subtitle": "Build sealed-safe compute previews and leave execution to the later Morpheus dispatch step.",
    "operations": [
      {
        "name": "Seal Compute Input",
        "method": "sealOracleRequest",
        "description": "Prepare sealed compute input metadata for Morpheus confidential handling.",
        "button_style": "success",
        "params": [
          {
            "name": "endpoint",
            "type": "string",
            "label": "Workflow input",
            "placeholder": "private-transfer-or-policy-check",
            "sensitive": true,
            "required": true
          }
        ]
      },
      {
        "name": "Build Preview",
        "method": "buildOraclePackage",
        "description": "Build a deterministic preview package without exposing sealed input.",
        "button_style": "secondary"
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": false
  },
  "createdAt": "2026-05-01T00:00:00Z",
  "updatedAt": "2026-05-01T00:00:00Z"
}
