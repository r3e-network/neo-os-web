{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-oracle-http-console",
  "name": "Oracle HTTP Console",
  "name_zh": "预言机 HTTP 控制台",
  "version": "1.0.0",
  "description": "Prepare HTTP oracle reads with URL, method, and extraction path.",
  "description_zh": "用 URL、方法和提取路径准备 HTTP 预言机读取。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [
    "oracle",
    "morpheus",
    "http",
    "datafeed"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-testnet",
  "urls": {
    "entry": "/miniapps/oracle-http-console/index.html",
    "icon": "/miniapps/oracle-http-console/logo.jpg",
    "banner": "/miniapps/oracle-http-console/banner.jpg"
  },
  "permissions": [
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://oracle-http-console"
  },
  "stateSource": {
    "type": "api",
    "chain": "neo-n3-testnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "operation_panel": {
    "title": "Oracle Request",
    "subtitle": "Build an HTTP oracle request and inspect the package.",
    "operations": [
      {
        "name": "Build Request",
        "method": "buildOraclePackage",
        "description": "Prepare an inspectable Morpheus HTTP oracle package.",
        "button_style": "secondary",
        "params": [
          {
            "name": "endpoint",
            "type": "string",
            "label": "Endpoint",
            "placeholder": "https://api.example.com/data",
            "required": true
          }
        ]
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": false
  },
  "createdAt": "2026-05-01T00:00:00Z",
  "updatedAt": "2026-05-01T00:00:00Z"
}
