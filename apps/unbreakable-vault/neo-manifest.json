{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-unbreakablevault",
  "name": "Unbreakable Vault",
  "name_zh": "无法破碎的金库",
  "version": "1.0.0",
  "description": "Hacker bounty vaults secured by secret hashes.",
  "description_zh": "黑客悬赏保险库：创建者用密钥哈希锁定 GAS 悬赏，挑战者按难度支付尝试费来破解，错误尝试会增加悬赏，过期未破解可由创建者取回。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0x198bfcccabb9b73181f23b5af22fe73afdc6c3aa",
    "neo-n3-testnet": "0x78fbd57ccfae14fff4b043a82eb491de542d8eb0"
  },
  "contract_domains": {
    "neo-n3-mainnet": "unbreakablevault.miniapp.neo"
  },
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/unbreakable-vault/index.html",
    "icon": "/miniapps/unbreakable-vault/logo.webp",
    "banner": "/miniapps/unbreakable-vault/banner.webp"
  },
  "permissions": [
    "invoke:primary",
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://unbreakable-vault"
  },
  "operation_panel": {
    "title": "Create or Break Vault",
    "subtitle": "Submit the funded wallet transactions used by the Unbreakable Vault contract.",
    "operations": [
      {
        "name": "Create Vault",
        "method": "createVault",
        "description": "Prepay the GAS bounty and create a SHA-256 hash-locked vault in one wallet-confirmed batch.",
        "button_style": "primary",
        "priority": "primary",
        "confirm_message": "Prepay this bounty and create the vault on-chain?",
        "params": [
          {
            "name": "creator",
            "type": "hash160",
            "label": "Creator",
            "required": true,
            "default_value": "$wallet",
            "hidden": true
          },
          {
            "name": "secretHash",
            "type": "string",
            "label": "Secret SHA-256 hash",
            "required": true,
            "placeholder": "64-character SHA-256 hex hash"
          },
          {
            "name": "bountyGas",
            "type": "amount",
            "label": "Bounty",
            "required": true,
            "default_value": "1.00",
            "scale": 8,
            "presets": [
              {
                "label": "1",
                "value": "1",
                "helper": "GAS"
              },
              {
                "label": "5",
                "value": "5",
                "helper": "GAS"
              },
              {
                "label": "10",
                "value": "10",
                "helper": "GAS"
              }
            ]
          },
          {
            "name": "difficulty",
            "type": "select",
            "label": "Difficulty",
            "required": true,
            "default_value": "1",
            "options": [
              {
                "label": "Easy",
                "value": "1"
              },
              {
                "label": "Medium",
                "value": "2"
              },
              {
                "label": "Hard",
                "value": "3"
              }
            ]
          },
          {
            "name": "title",
            "type": "string",
            "label": "Vault title",
            "required": true,
            "placeholder": "Crack me if you can"
          },
          {
            "name": "description",
            "type": "string",
            "label": "Public hint",
            "placeholder": "Optional clue for breakers"
          },
          {
            "name": "receiptId",
            "type": "integer",
            "label": "Payment receipt ID",
            "placeholder": "Required only for mainnet receipt flows"
          }
        ]
      },
      {
        "name": "Attempt Break",
        "method": "attemptBreak",
        "description": "Prepay the attempt fee and submit a secret attempt against an active vault.",
        "button_style": "danger",
        "priority": "secondary",
        "confirm_message": "Pay the attempt fee and try to break this vault?",
        "params": [
          {
            "name": "vaultId",
            "type": "integer",
            "label": "Vault ID",
            "required": true,
            "placeholder": "1"
          },
          {
            "name": "secret",
            "type": "string",
            "label": "Break secret",
            "required": true,
            "placeholder": "Secret phrase"
          },
          {
            "name": "attemptFeeGas",
            "type": "amount",
            "label": "Attempt fee",
            "required": true,
            "default_value": "0.10",
            "scale": 8,
            "presets": [
              {
                "label": "0.10",
                "value": "0.10",
                "helper": "Easy"
              },
              {
                "label": "0.50",
                "value": "0.50",
                "helper": "Medium"
              },
              {
                "label": "1.00",
                "value": "1.00",
                "helper": "Hard"
              }
            ]
          },
          {
            "name": "receiptId",
            "type": "integer",
            "label": "Payment receipt ID",
            "placeholder": "Required only for mainnet receipt flows"
          }
        ]
      },
      {
        "name": "Increase Bounty",
        "method": "increaseBounty",
        "description": "Prepay additional GAS and increase an active vault bounty.",
        "button_style": "secondary",
        "priority": "secondary",
        "confirm_message": "Add this GAS amount to the vault bounty?",
        "params": [
          {
            "name": "vaultId",
            "type": "integer",
            "label": "Vault ID",
            "required": true,
            "placeholder": "1"
          },
          {
            "name": "bountyGas",
            "type": "amount",
            "label": "Bounty top-up",
            "required": true,
            "default_value": "1.00",
            "scale": 8,
            "presets": [
              {
                "label": "1",
                "value": "1",
                "helper": "GAS"
              },
              {
                "label": "5",
                "value": "5",
                "helper": "GAS"
              }
            ]
          },
          {
            "name": "receiptId",
            "type": "integer",
            "label": "Payment receipt ID",
            "placeholder": "Required only for mainnet receipt flows"
          }
        ]
      },
      {
        "name": "Claim Expired Vault",
        "method": "claimExpiredVault",
        "description": "Claim an expired vault refund as the creator.",
        "button_style": "secondary",
        "priority": "operator",
        "confirm_message": "Claim this expired vault refund?",
        "params": [
          {
            "name": "vaultId",
            "type": "integer",
            "label": "Vault ID",
            "required": true,
            "placeholder": "1"
          }
        ]
      }
    ]
  },
  "stateSource": {
    "type": "n3index",
    "chain": "neo-n3-mainnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-06-01T00:00:00Z"
}
