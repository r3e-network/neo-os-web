{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-neo-x-bridge",
  "name": "Neo X Bridge",
  "name_zh": "Neo X 跨链桥",
  "version": "1.0.0",
  "description": "Prepare official Neo N3 / Neo X bridge handoffs and track operation status in one console.",
  "description_zh": "在一个控制台里准备官方 Neo N3 / Neo X 跨链桥交接载荷并追踪操作状态。",
  "category": "defi",
  "category_name": "DeFi",
  "category_name_zh": "DeFi",
  "tags": [
    "bridge",
    "neo-x",
    "message-bridge",
    "transfer",
    "defi"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet",
    "neo-x-mainnet",
    "neo-x-testnet"
  ],
  "default_network": "neo-n3-testnet",
  "urls": {
    "entry": "/miniapps/neo-x-bridge/index.html",
    "icon": "/miniapps/neo-x-bridge/logo.jpg",
    "banner": "/miniapps/neo-x-bridge/banner.jpg"
  },
  "permissions": [
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://neo-x-bridge"
  },
  "stateSource": {
    "type": "api",
    "chain": "neo-n3-testnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "operation_panel": {
    "title": "Bridge Console",
    "subtitle": "Asset bridge, Message Bridge, and status tracking share one official bridge handoff flow.",
    "operations": [
      {
        "name": "Bridge Asset",
        "method": "bridgeAsset",
        "description": "Prepare a Neo N3 / Neo X asset bridge handoff and mirror it in the playarea route board.",
        "button_style": "success",
        "params": [
          {
            "name": "direction",
            "type": "select",
            "label": "Direction",
            "default_value": "n3-to-neox",
            "options": [
              { "label": "Neo N3 → Neo X", "value": "n3-to-neox" },
              { "label": "Neo X → Neo N3", "value": "neox-to-n3" }
            ]
          },
          {
            "name": "amount",
            "type": "amount",
            "label": "Amount",
            "placeholder": "0.00",
            "required": true
          },
          {
            "name": "recipient",
            "type": "string",
            "label": "Destination address",
            "placeholder": "Neo N3 or Neo X address",
            "required": true
          }
        ]
      },
      {
        "name": "Send Message",
        "method": "bridgeMessage",
        "description": "Prepare a Message Bridge payload for the selected target contract.",
        "button_style": "secondary",
        "params": [
          {
            "name": "targetContract",
            "type": "hash160",
            "label": "Target contract",
            "placeholder": "0x...",
            "required": true
          },
          {
            "name": "message",
            "type": "string",
            "label": "Message",
            "placeholder": "sync:miniapp-state",
            "required": true
          }
        ]
      },
      {
        "name": "Track Operation",
        "method": "trackBridgeOperation",
        "description": "Track a lock, relay, or release transaction.",
        "button_style": "secondary",
        "params": [
          {
            "name": "txHash",
            "type": "hash256",
            "label": "Transaction hash",
            "placeholder": "0x...",
            "required": true
          }
        ]
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-05-01T00:00:00Z",
  "updatedAt": "2026-05-03T00:00:00Z"
}
