{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-aa-relay-console",
  "name": "AA Relay Console",
  "name_zh": "AA Relay 控制台",
  "version": "1.0.0",
  "description": "Inspect and submit relay-ready payloads for the shared Neo Abstract Account relay.",
  "description_zh": "检查并提交共享 Neo 抽象账户 relay 的 relay-ready payload。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [
    "aa",
    "relay",
    "paymaster",
    "sponsor"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0x0268a387913b250166ddec032b03332690a1ef78",
    "neo-n3-testnet": "0xdbf38e7b2117186bf7a5e17ead702322c0c5b6f2"
  },
  "contract_domains": {
    "neo-n3-mainnet": "core.smartwallet.neo"
  },
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/aa-relay-console/index.html",
    "icon": "/miniapps/aa-relay-console/logo.webp",
    "banner": "/miniapps/aa-relay-console/banner.webp"
  },
  "permissions": [
    "read:blockchain",
    "invoke:primary"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://aa-relay-console"
  },
  "stateSource": {
    "type": "api",
    "chain": "neo-n3-mainnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "operation_panel": {
    "title": "AA Relay Console",
    "subtitle": "Check sponsor coverage, request paymaster support, then submit a relay-ready AA payload.",
    "operations": [
      {
        "name": "Check Sponsorship",
        "method": "checkSponsor",
        "description": "Check whether this AA address is eligible for the selected paymaster scope.",
        "button_style": "secondary",
        "priority": "primary",
        "params": [
          {
            "name": "aaAddress",
            "type": "address",
            "label": "AA Address",
            "required": true
          },
          {
            "name": "dappId",
            "type": "string",
            "label": "Paymaster dApp ID",
            "default_value": "miniapp-aa-relay-console"
          }
        ]
      },
      {
        "name": "Request Sponsorship",
        "method": "requestSponsor",
        "description": "Request GAS sponsorship from the paymaster for this AA scope.",
        "button_style": "success",
        "priority": "primary",
        "params": [
          {
            "name": "aaAddress",
            "type": "address",
            "label": "AA Address",
            "required": true
          },
          {
            "name": "dappId",
            "type": "string",
            "label": "Paymaster dApp ID",
            "default_value": "miniapp-aa-relay-console"
          },
          {
            "name": "sponsorAmount",
            "type": "amount",
            "label": "Sponsor Amount",
            "default_value": "0.1",
            "required": true
          }
        ]
      },
      {
        "name": "Submit Relay Payload",
        "method": "submitRelay",
        "description": "Submit a relay-ready AA payload through the platform relay proxy.",
        "button_style": "primary",
        "priority": "primary",
        "confirm_message": "Submit this payload to the AA relay?",
        "params": [
          {
            "name": "aaAddress",
            "type": "address",
            "label": "AA Address",
            "required": true
          },
          {
            "name": "dappId",
            "type": "string",
            "label": "Paymaster dApp ID",
            "default_value": "miniapp-aa-relay-console"
          },
          {
            "name": "payloadJson",
            "type": "string",
            "label": "Relay Payload JSON",
            "default_value": "{\n  \"metaInvocation\": {\n    \"scriptHash\": \"0x0268a387913b250166ddec032b03332690a1ef78\"\n  }\n}",
            "required": true
          }
        ]
      }
    ]
  },
  "createdAt": "2026-03-18T05:10:00Z",
  "updatedAt": "2026-05-08T00:00:00Z"
}
