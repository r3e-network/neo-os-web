{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-flashloan",
  "name": "Flash Loan",
  "name_zh": "闪电贷",
  "version": "1.0.0",
  "description": "Execute instant uncollateralized loans in a single transaction",
  "description_zh": "闪电贷 — 无抵押即时借贷，单笔交易内完成借还",
  "category": "finance",
  "category_name": "Finance",
  "category_name_zh": "金融",
  "tags": [
    "defi",
    "loans",
    "flash"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0xb5d8fb0dc2319edc4be3104304b4136b925df6e4",
    "neo-n3-testnet": "0xde8e595d8d3c293731db499367ee2a768e1e458b"
  },
  "contract_domains": {
    "neo-n3-mainnet": "flashloan.miniapp.neo"
  },
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/flashloan/index.html",
    "icon": "/miniapps/flashloan/logo.webp",
    "banner": "/miniapps/flashloan/banner.webp"
  },
  "permissions": [
    "invoke:primary",
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://flashloan"
  },
  "stateSource": {
    "type": "n3index",
    "chain": "neo-n3-mainnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "operation_panel": {
    "title": "Flash Loan Console",
    "subtitle": "Prepare requestFlashLoan inputs, submit through the embedded wallet flow, and query on-chain loan status.",
    "operations": [
      {
        "name": "Request Flash Loan",
        "method": "requestLoan",
        "description": "Invoke requestFlashLoan with a GAS amount and callback contract implementing onFlashLoan.",
        "button_style": "success",
        "params": [
          {
            "name": "amount",
            "type": "amount",
            "label": "Loan amount",
            "placeholder": "1",
            "required": true
          },
          {
            "name": "callbackContract",
            "type": "hash160",
            "label": "Callback contract",
            "placeholder": "0x...",
            "required": true
          }
        ]
      },
      {
        "name": "Lookup Loan",
        "method": "lookupLoan",
        "description": "Read getFlashLoan(appId, loanId) for a previously executed loan.",
        "button_style": "secondary",
        "params": [
          {
            "name": "loanId",
            "type": "integer",
            "label": "Loan ID",
            "placeholder": "1",
            "required": true
          }
        ]
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-01-26T12:00:00Z"
}
