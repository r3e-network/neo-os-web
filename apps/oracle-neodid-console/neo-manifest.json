{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-oracle-neodid-console",
  "name": "Oracle NeoDID Console",
  "name_zh": "预言机 NeoDID 控制台",
  "version": "1.0.0",
  "description": "Prepare NeoDID verification requests for Morpheus oracle flows.",
  "description_zh": "为 Morpheus 预言机流程准备 NeoDID 校验请求。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [
    "oracle",
    "morpheus",
    "neodid",
    "identity"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-testnet",
  "urls": {
    "entry": "/miniapps/oracle-neodid-console/index.html",
    "icon": "/miniapps/oracle-neodid-console/logo.jpg",
    "banner": "/miniapps/oracle-neodid-console/banner.jpg"
  },
  "permissions": {
    "read": true,
    "oracle": true,
    "compute": true,
    "confidential": true,
    "aa": true
  },
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://oracle-neodid-console"
  },
  "stateSource": {
    "type": "api",
    "chain": "neo-n3-testnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "operation_panel": {
    "title": "NeoDID Oracle",
    "subtitle": "Build or seal NeoDID verification requests from the action console.",
    "operations": [
      {
        "name": "Seal DID Request",
        "method": "sealOracleRequest",
        "description": "Encrypt the NeoDID subject and verification request for Morpheus handling.",
        "button_style": "success",
        "params": [
          {
            "name": "endpoint",
            "type": "string",
            "label": "DID subject",
            "placeholder": "did:neo:...",
            "required": true
          }
        ]
      },
      {
        "name": "Build Preview",
        "method": "buildOraclePackage",
        "description": "Build a visible NeoDID request package.",
        "button_style": "secondary"
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": false
  },
  "createdAt": "2026-05-01T00:00:00Z",
  "updatedAt": "2026-05-01T00:00:00Z"
}
