  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-05-08T13:07:29Z",
  "featured": true,
  "featured_order": 7,
  "technologies": {
    "oracle": {
      "enabled": false,
      "description": "No off-chain oracle. The draw uses on-chain commit/reveal randomness (a later block's Runtime.GetRandom), settled by a permissionless reveal."
    },
    "vrf": {
      "enabled": true,
      "description": "Provably-fair on-chain randomness via commit/reveal: the outcome is fixed by a later block's Runtime.GetRandom, so it is unknowable at bet time and cannot be aborted on a loss"
    },
    "aa": {
      "enabled": false,
      "description": "AA rapid-draw integration is planned but is not the live testnet flow"
    },
    "keeper": {
      "enabled": true,
      "description": "Auto-broadcasts big win announcements and triggers fireworks",
      "conditions": [
        "big_win_event"
      ]
    }
  },
  "runtime": {
    "mode": "platform",
    "modules": [
