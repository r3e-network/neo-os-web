{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-explorer",
  "name": "Block Explorer",
  "name_zh": "区块浏览器",
  "version": "1.1.0",
  "description": "Search Neo N3 blocks, transactions, addresses, and contracts with source-qualified live data.",
  "description_zh": "查询 Neo N3 区块、交易、地址和合约，并明确展示实时数据来源。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [
    "explorer",
    "blockchain",
    "transactions",
    "search"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/explorer/index.html",
    "icon": "/miniapps/explorer/logo.webp",
    "banner": "/miniapps/explorer/banner.webp"
  },
  "permissions": [
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://explorer"
  },
  "stateSource": {
    "type": "api",
    "endpoints": [
      "https://neomini.app/api/explorer",
      "https://mainnet2.neo.coz.io:443",
      "https://testnet1.neo.coz.io:443"
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": false
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-07-12T00:00:00Z"
}
