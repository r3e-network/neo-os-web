{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-explorer",
  "name": "Block Explorer",
  "name_zh": "区块浏览器",
  "version": "1.0.0",
  "description": "Explore Neo N3 blockchain - transactions, addresses, contracts",
  "description_zh": "区块链浏览器 — Neo N3 链上数据查询与交易追踪工具",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [
    "explorer",
    "blockchain",
    "transactions",
    "search"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-mainnet"
  ],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/explorer/index.html",
    "icon": "/miniapps/explorer/logo.jpg",
    "banner": "/miniapps/explorer/banner.jpg"
  },
  "permissions": [
    "invoke:primary",
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://explorer"
  },
  "stateSource": {
    "type": "api",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "operation_panel": {
    "title": "Explorer Search",
    "subtitle": "Run a live chain lookup from the right console. Results render in the central playarea.",
    "operations": [
      {
        "name": "Search Chain",
        "method": "explorerSearch",
        "description": "Search a block height, transaction hash, address, or contract hash against the selected network.",
        "button_style": "secondary",
        "params": [
          {
            "name": "network",
            "type": "select",
            "label": "Network",
            "default_value": "mainnet",
            "options": [
              { "label": "Mainnet", "value": "mainnet" },
              { "label": "Testnet", "value": "testnet" }
            ]
          },
          {
            "name": "query",
            "type": "string",
            "label": "Search query",
            "placeholder": "Block height, tx hash, address, or contract",
            "required": true
          }
        ]
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-01-28T21:07:41Z"
}
