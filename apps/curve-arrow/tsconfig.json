{
  "extends": "../tsconfig.miniapp.react.json",
  "compilerOptions": {
    // The deterministic arrow-engine (client twin of the TEE engine) indexes
    // const tuples with clamped integer offsets; it is kept byte-comparable
    // with the oracle port, so the unchecked-index guard is relaxed here
    // instead of rewriting the engine.
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@framework/*": ["../../framework/*"],
      "@shared/*": [
        "../shared/*"
      ]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
