{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-oracle-seal-console",
  "name": "Oracle Seal Console",
  "name_zh": "预言机加密封装控制台",
  "version": "1.0.0",
  "description": "Package sensitive oracle input as a sealed envelope preview.",
  "description_zh": "把敏感预言机输入打包为加密封装预览。",
  "category": "tools",
  "category_name": "Tools",
  "category_name_zh": "工具",
  "tags": [
    "oracle",
    "morpheus",
    "seal",
    "privacy"
  ],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {},
  "supported_networks": [
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-testnet",
  "urls": {
    "entry": "/miniapps/oracle-seal-console/index.html",
    "icon": "/miniapps/oracle-seal-console/logo.jpg",
    "banner": "/miniapps/oracle-seal-console/banner.jpg"
  },
  "permissions": {
    "read": true,
    "oracle": true,
    "compute": true,
    "confidential": true
  },
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://oracle-seal-console"
  },
  "stateSource": {
    "type": "api",
    "chain": "neo-n3-testnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "operation_panel": {
    "title": "Seal Console",
    "subtitle": "Seal sensitive oracle input and inspect the encrypted reference.",
    "operations": [
      {
        "name": "Seal Payload",
        "method": "sealOracleRequest",
        "description": "Encrypt a sensitive payload for Morpheus confidential handling.",
        "button_style": "success",
        "params": [
          {
            "name": "endpoint",
            "type": "string",
            "label": "Payload",
            "placeholder": "sensitive oracle input",
            "required": true
          }
        ]
      },
      {
        "name": "Build Preview",
        "method": "buildOraclePackage",
        "description": "Build a visible preview package without sealing.",
        "button_style": "secondary"
      }
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": false
  },
  "createdAt": "2026-05-01T00:00:00Z",
  "updatedAt": "2026-05-01T00:00:00Z"
}
