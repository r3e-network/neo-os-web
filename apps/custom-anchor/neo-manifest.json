{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-custom-anchor",
  "name": "Custom Anchor",
  "name_zh": "自定义锚",
  "version": "2.0.0",
  "description": "Production NEO governance and yield anchor. Stake or redeem NEO, claim GAS, and provision a new anchor through a durable fee-to-21-agent workflow with exact event and readback recovery.",
  "description_zh": "生产级 NEO 治理与收益 Anchor：质押或赎回 NEO、领取 GAS，并通过可持久恢复、精确事件与链上回读确认的费用到 21-agent 流程创建 Anchor。",
  "category": "governance",
  "category_name": "Governance",
  "category_name_zh": "治理",
  "tags": ["staking", "voting", "anchor", "aa", "governance"],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0x02beeef6f65c6989a121c0a0e6b23190333edb98",
    "neo-n3-testnet": "0xab079b4f9a0a2471d136392e25eb8e99898dcad0"
  },
  "contract_domains": {
    "neo-n3-mainnet": "customanchor.miniapp.neo"
  },
  "runtime": {
    "mode": "platform",
    "modules": [
      {
        "binding": "anchor-staking",
        "platform": "PlatformAnchor",
        "appId": "miniapp-custom-anchor",
        "moduleType": 2,
        "registration": {
          "method": "registerCustomAnchorApp",
          "type": "custom"
        },
        "operations": {
          "register": "registerCustomAnchorApp",
          "registerAgents": "registerAgents",
          "stake": "stake",
          "withdraw": "withdraw",
          "claimRewards": "claimRewards",
          "moveAgentNeo": "transferAgentNeo",
          "setAgentCandidate": "setAgentCandidate",
          "syncVote": "voteAgent",
          "stats": "getAnchorStats"
        },
        "networks": {
          "neo-n3-mainnet": {
            "contract_hash": "0x02beeef6f65c6989a121c0a0e6b23190333edb98",
            "registered": true
          },
          "neo-n3-testnet": {
            "contract_hash": "0xab079b4f9a0a2471d136392e25eb8e99898dcad0",
            "registered": true
          }
        }
      }
    ]
  },
  "supported_networks": ["neo-n3-mainnet", "neo-n3-testnet"],
  "default_network": "neo-n3-mainnet",
  "urls": {
    "entry": "/miniapps/custom-anchor/index.html",
    "icon": "/miniapps/custom-anchor/logo.webp",
    "banner": "/miniapps/custom-anchor/banner.webp"
  },
  "permissions": ["invoke:primary", "read:blockchain", "aa:register"],
  "features": {
    "stateless": false,
    "offlineSupport": false,
    "deeplink": "neomainapp://custom-anchor"
  },
  "stateSource": {
    "type": "chain",
    "chain": "neo-n3-mainnet"
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-05-09T00:00:00Z",
  "updatedAt": "2026-07-12T00:00:00Z"
}
