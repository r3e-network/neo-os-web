{
  "$schema": "https://schemas.r3e.network/miniapp-manifest/v1.json",
  "id": "miniapp-memorial-shrine",
  "name": "Memorial Shrine",
  "name_zh": "纪念堂",
  "version": "1.0.0",
  "description": "Create eternal digital memorials for loved ones on the blockchain. Honor and remember with permanent on-chain tributes.",
  "description_zh": "纪念神殿 — 在链上为重要时刻和人物建立永恒纪念碑",
  "category": "social",
  "category_name": "Social",
  "category_name_zh": "社交",
  "tags": [],
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "website": "https://neomini.app"
  },
  "contracts": {
    "neo-n3-mainnet": "0xee7a548b71c69364fcb0e45a63a40f141b938e42",
    "neo-n3-testnet": "0x87f0fe2ba69cd973a3274471234d3cc13ef943c5"
  },
  "contract_domains": {
    "neo-n3-mainnet": "memorialshrine.miniapp.neo"
  },
  "supported_networks": [
    "neo-n3-mainnet",
    "neo-n3-testnet"
  ],
  "default_network": "neo-n3-mainnet",
  "operation_panel": {
    "title": "Memorial Shrine Operations",
    "subtitle": "Create permanent memorial records and offer prepaid GAS tributes from the connected wallet.",
    "operations": [
      {
        "name": "Create Memorial",
        "method": "createMemorial",
        "description": "Create an on-chain memorial record with the connected wallet as creator.",
        "button_style": "primary",
        "priority": "primary",
        "confirm_message": "Create this memorial on-chain?",
        "params": [
          {
            "name": "creator",
            "type": "hash160",
            "label": "Creator",
            "required": true,
            "default_value": "$wallet",
            "hidden": true
          },
          {
            "name": "name",
            "type": "string",
            "label": "Memorial name",
            "required": true,
            "placeholder": "Loved one"
          },
          {
            "name": "photoHash",
            "type": "string",
            "label": "Photo hash",
            "placeholder": "IPFS hash or HTTPS image URL"
          },
          {
            "name": "relationship",
            "type": "string",
            "label": "Relationship",
            "placeholder": "Parent, mentor, friend"
          },
          {
            "name": "birthYear",
            "type": "integer",
            "label": "Birth year",
            "default_value": "1950",
            "placeholder": "1950"
          },
          {
            "name": "deathYear",
            "type": "integer",
            "label": "Death year",
            "required": true,
            "default_value": "2024",
            "placeholder": "2024"
          },
          {
            "name": "biography",
            "type": "string",
            "label": "Biography",
            "placeholder": "A short life story"
          },
          {
            "name": "obituary",
            "type": "string",
            "label": "Obituary",
            "placeholder": "A public remembrance"
          }
        ]
      },
      {
        "name": "Pay Tribute",
        "method": "payTribute",
        "description": "Prepay the selected offering cost and record a tribute message on-chain.",
        "button_style": "success",
        "priority": "secondary",
        "confirm_message": "Prepay this offering and submit the tribute?",
        "params": [
          {
            "name": "visitor",
            "type": "hash160",
            "label": "Visitor",
            "required": true,
            "default_value": "$wallet",
            "hidden": true
          },
          {
            "name": "memorialId",
            "type": "integer",
            "label": "Memorial ID",
            "required": true,
            "placeholder": "1"
          },
          {
            "name": "offeringType",
            "type": "select",
            "label": "Offering",
            "required": true,
            "default_value": "1",
            "options": [
              {
                "label": "Incense · 0.01 GAS",
                "value": "1"
              },
              {
                "label": "Candle · 0.02 GAS",
                "value": "2"
              },
              {
                "label": "Flowers · 0.03 GAS",
                "value": "3"
              },
              {
                "label": "Fruit · 0.05 GAS",
                "value": "4"
              },
              {
                "label": "Wine · 0.10 GAS",
                "value": "5"
              },
              {
                "label": "Feast · 0.50 GAS",
                "value": "6"
              }
            ]
          },
          {
            "name": "message",
            "type": "string",
            "label": "Tribute message",
            "placeholder": "Always remembered"
          },
          {
            "name": "receiptId",
            "type": "integer",
            "label": "Payment receipt ID",
            "placeholder": "Required only for mainnet receipt flows"
          }
        ]
      }
    ]
  },
  "urls": {
    "entry": "/miniapps/memorial-shrine/index.html",
    "icon": "/miniapps/memorial-shrine/logo.jpg",
    "banner": "/miniapps/memorial-shrine/banner.jpg"
  },
  "permissions": [
    "invoke:primary",
    "read:blockchain"
  ],
  "features": {
    "stateless": true,
    "offlineSupport": false,
    "deeplink": "neomainapp://memorial-shrine"
  },
  "stateSource": {
    "type": "n3index",
    "chain": "neo-n3-mainnet",
    "endpoints": [
      "https://api.n3index.dev"
    ]
  },
  "platform": {
    "analytics": true,
    "comments": true,
    "ratings": true,
    "transactions": true
  },
  "createdAt": "2026-01-01T00:00:00Z",
  "updatedAt": "2026-06-01T00:00:00Z"
}
