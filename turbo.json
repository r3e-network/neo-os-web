{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"],
      "cache": true,
      "env": [
        "NODE_ENV",
        "NEXT_PRIVATE_TARGET",
        "EDGE_API_BASE",
        "SENDGRID_FROM_EMAIL",
        "AUTH0_SECRET",
        "AUTH0_ISSUER_BASE_URL",
        "AUTH0_CLIENT_ID",
        "AUTH0_CLIENT_SECRET",
        "AUTH0_BASE_URL",
        "SENDGRID_API_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "HOST_APP_BASE_URL",
        "MINIAPP_HOST_APP_BASE_URL",
        "NEO_TARGET_NETWORK",
        "NEO_RPC_URL",
        "NEO_RPC_MAINNET",
        "NEO_RPC_TESTNET",
        "NEO_NETWORK_MAGIC",
        "MORPHEUS_PUBLIC_API_URL",
        "MORPHEUS_RUNTIME_URL",
        "MORPHEUS_EDGE_URL",
        "MORPHEUS_CONTROL_PLANE_URL",
        "MORPHEUS_MAINNET_PUBLIC_API_URL",
        "MORPHEUS_MAINNET_RUNTIME_URL",
        "MORPHEUS_MAINNET_EDGE_URL",
        "MORPHEUS_MAINNET_CONTROL_PLANE_URL",
        "MORPHEUS_TESTNET_PUBLIC_API_URL",
        "MORPHEUS_TESTNET_RUNTIME_URL",
        "MORPHEUS_TESTNET_EDGE_URL",
        "MORPHEUS_TESTNET_CONTROL_PLANE_URL",
        "VITE_WEB3AUTH_NETWORK",
        "VITE_WEB3AUTH_CLIENT_ID",
        "NEXT_PUBLIC_WEB3AUTH_NETWORK",
        "NEXT_PUBLIC_WEB3AUTH_CLIENT_ID",
        "RESEND_API_KEY",
        "SPONSORED_WIF",
        "ONEGATE_VAULT_KEY_PEPPER",
        "ONEGATE_VAULT_TX_PROXY_URL",
        "ONEGATE_VAULT_REWARD_SOURCE",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_EDGE_URL",
        "NEXTAUTH_SECRET"
      ]
    },
    "build:h5": {
      "dependsOn": ["^build"],
      "outputs": ["dist/build/h5/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputs": [],
      "cache": true
    },
    "test:run": {
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  }
}
