{
  "extends": "next/core-web-vitals",
  "rules": {
    "react-hooks/exhaustive-deps": "warn",
    "@next/next/no-img-element": "warn",
    "react/no-unescaped-entities": "off",
    "react/display-name": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "next-env.d.ts",
    "**/*.d.ts",
    "playwright-report/",
    "test-results/",
    "lib/codegen/",
    "supabase/functions/"
  ]
}
