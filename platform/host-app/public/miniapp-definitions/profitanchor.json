{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-profitanchor",
  "name": "ProfitAnchor",
  "description": "Manual 21-agent AA routing desk for profit-policy NEO voting. Operators rebalance between candidate agents and sync votes explicitly.",
  "template_type": "defi",
  "category": "DeFi",
  "tags": ["staking", "voting", "gas-yield", "profit", "aa"],
  "version": "1.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "platform-anchor",
    "init_params": {
      "anchor_app_id": "miniapp-profitanchor",
      "mode": 2
    }
  },
  "entry_url": "mf://manifest?app=miniapp-profitanchor",
  "media": {
    "icon": "/miniapp-assets/profitanchor/logo.jpg",
    "banner": "/miniapp-assets/profitanchor/banner.jpg"
  },
  "permissions": {
    "payments": true,
    "governance": true,
    "aa": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "ProfitAnchor"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "success",
            "content": "ProfitAnchor is an operator desk for explicit AA-agent routing. Admins move NEO between candidate agents and sync votes deliberately."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Asset",
                "value": "NEO"
              },
              {
                "key": "Strategy",
                "value": "Manual route"
              },
              {
                "key": "Vote Identity",
                "value": "AA agent accounts"
              },
              {
                "key": "Agent Set",
                "value": "21 AA accounts"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How it works",
            "items": [
              "Each anchor owns its own 21 AA agent accounts, one per council candidate.",
              "Operators rebalance by transferring NEO from one agent account to another.",
              "When the candidate list changes, operators update an agent's vote target and then sync that agent vote."
            ]
          }
        ]
      },
      {
        "id": "profit",
        "label": "Profit Routing",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Keep the main workflow simple: move NEO, update candidate, sync vote. Agent derivation and accounting details belong in secondary views."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Stake / Withdraw / Claim",
      "subtitle": "Users manage their NEO stake here. Operator routing tools stay secondary.",
      "cta_label": "Open ProfitAnchor",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Stake NEO",
      "method": "stakeNeo",
      "button_style": "primary",
      "priority": "primary",
      "params": [
        {
          "name": "amount",
          "type": "integer",
          "label": "NEO",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Withdraw NEO",
      "method": "withdrawNeo",
      "button_style": "secondary",
      "priority": "primary",
      "params": [
        {
          "name": "amount",
          "type": "integer",
          "label": "NEO",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Claim Rewards",
      "method": "claimRewards",
      "button_style": "success",
      "priority": "primary",
      "params": []
    },
    {
      "name": "Move NEO",
      "method": "transferAgentNeo",
      "button_style": "secondary",
      "priority": "operator",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-profitanchor",
          "hidden": true
        },
        {
          "name": "fromAgentId",
          "type": "integer",
          "label": "From agent",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "toAgentId",
          "type": "integer",
          "label": "To agent",
          "required": true,
          "placeholder": "2"
        },
        {
          "name": "amount",
          "type": "integer",
          "label": "NEO",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Update Vote Target",
      "method": "setAgentCandidate",
      "button_style": "secondary",
      "priority": "operator",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-profitanchor",
          "hidden": true
        },
        {
          "name": "agentId",
          "type": "integer",
          "label": "Agent",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "candidate",
          "type": "publickey",
          "label": "Candidate public key",
          "required": true,
          "placeholder": "02..."
        }
      ]
    },
    {
      "name": "Sync Vote",
      "method": "voteAgent",
      "button_style": "secondary",
      "priority": "operator",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-profitanchor",
          "hidden": true
        },
        {
          "name": "agentId",
          "type": "integer",
          "label": "Agent",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Register Agent",
      "method": "registerAgent",
      "button_style": "secondary",
      "priority": "operator",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-profitanchor",
          "hidden": true
        },
        {
          "name": "agentAccount",
          "type": "hash160",
          "label": "Agent account",
          "required": true,
          "placeholder": "0x..."
        },
        {
          "name": "candidate",
          "type": "publickey",
          "label": "Candidate public key",
          "required": true,
          "placeholder": "02..."
        },
        {
          "name": "verificationScriptHash",
          "type": "bytearray",
          "label": "Verification script hash",
          "required": true,
          "placeholder": "hex"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "weekly_active_users",
      "total_gas_used"
    ]
  },
  "logic": {
    "provides": ["profitanchor.manualAgentRouting"],
    "consumers": ["miniapp-self-loan"]
  },
  "docs_url": "https://docs.r3e.network/profitanchor"
}
