{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-doomsday-clock",
  "name": "LastSurvivor",
  "description": "Prize pool grows with every contribution; the 24-hour countdown resets on each press. Last contributor wins everything if the timer reaches zero.",
  "template_type": "gaming",
  "category": "Gaming",
  "tags": [
    "last-survivor",
    "countdown",
    "tontine",
    "jackpot",
    "social-experiment"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "R3E Network",
    "url": "https://r3e.network"
  },
  "contract": {
    "template_id": "gaming-last-survivor",
    "contract_hash": "0xf0914d411877c8393c029f48ec0c4c64d44f1b49"
  },
  "entry_url": "mf://manifest?app=miniapp-doomsday-clock",
  "media": {
    "icon": "/miniapps/doomsday-clock/logo.jpg",
    "banner": "/miniapps/doomsday-clock/banner.jpg"
  },
  "permissions": {
    "payments": true,
    "randomness": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "LastSurvivor"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content"
      },
      {
        "id": "history",
        "label": "History",
        "type": "content"
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Buy Keys",
      "subtitle": "Reset the countdown and fight for the last spot.",
      "cta_label": "Open LastSurvivor",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Buy Keys",
      "method": "buyKeys",
      "button_style": "primary",
      "params": [
        {
          "name": "keyCount",
          "type": "integer",
          "label": "Key Count",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "receiptId",
          "type": "integer",
          "label": "Receipt ID",
          "required": true,
          "placeholder": "1"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "daily_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/lastsurvivor"
}
