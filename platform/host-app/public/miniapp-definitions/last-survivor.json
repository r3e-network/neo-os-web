{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-last-survivor",
  "name": "LastSurvivor",
  "description": "A bright Phaser last-seat duel: local rivals steal the lead on an unpredictable rhythm, smaller packs score higher, and only the leader at zero survives. The paid contract lane stays hidden until its wallet and settlement flow is revalidated.",
  "template_type": "gaming",
  "category": "Gaming",
  "tags": [
    "last-survivor",
    "arcade",
    "local-rivals",
    "score-chase",
    "phaser"
  ],
  "version": "2.2.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "entry_url": "mf://manifest?app=miniapp-last-survivor",
  "media": {
    "icon": "/miniapp-assets/last-survivor/logo.webp",
    "banner": "/miniapp-assets/last-survivor/banner.webp"
  },
  "permissions": {
    "payments": false,
    "randomness": false
  },
  "frontend_spec": {
    "layout": "immersive",
    "hero": {
      "eyebrow": "LastSurvivor"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Play the complete guest duel immediately. Choose a pack, time each move against local rivals, protect the lead, and survive the final countdown. Progress and match history recover after refresh."
          },
          {
            "type": "key_value",
            "title": "Current release",
            "items": [
              {
                "key": "Mode",
                "value": "Guest arcade duel"
              },
              {
                "key": "Controls",
                "value": "Pack selection + timed moves"
              },
              {
                "key": "Progress",
                "value": "Local save and refresh recovery"
              },
              {
                "key": "GameFi",
                "value": "Hidden until the paid flow is revalidated"
              }
            ]
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "LastSurvivor Arena",
      "subtitle": "Start the real guest game in the play area. No wallet or funding form is required.",
      "cta_label": "Enter Arena",
      "operations": []
    }
  },
  "operations": [],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": false,
    "stats_display": []
  },
  "docs_url": "https://docs.r3e.network/lastsurvivor",
  "manifest": {
    "contracts": {
      "neo-n3-mainnet": "0x8e1e432e966357de8d7642564b744d3274a81bd0",
      "neo-n3-testnet": "0xff122a6cf7f22a88d059d61a9d9c07e84a2b56b9"
    },
    "contract_domains": {
      "neo-n3-mainnet": "lastsurvivor.miniapp.neo"
    },
    "platform": {
      "analytics": true,
      "comments": true,
      "ratings": true,
      "transactions": false
    },
    "permissions": [],
    "operation_panel": {
      "operations": []
    }
  }
}
