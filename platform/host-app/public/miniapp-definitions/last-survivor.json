{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-last-survivor",
  "name": "LastSurvivor",
  "description": "Prize pool grows with every contribution; each key purchase extends the live countdown. Last contributor wins when the timer reaches zero.",
  "template_type": "gaming",
  "category": "Gaming",
  "tags": [
    "last-survivor",
    "countdown",
    "tontine",
    "jackpot",
    "social-experiment"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "gaming-last-survivor",
    "contract_hash": "0xa7840a8d5404bbe297a00756a29cc267d6fa6cc7"
  },
  "entry_url": "mf://manifest?app=miniapp-last-survivor",
  "media": {
    "icon": "/miniapp-assets/last-survivor/logo.jpg",
    "banner": "/miniapp-assets/last-survivor/banner.jpg"
  },
  "permissions": {
    "payments": true,
    "randomness": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "LastSurvivor"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Last Survivor is a countdown jackpot. Every GAS transfer buys a key, extends the timer, and crowns the sender as the current leader. When the timer hits zero, the contract settles the round by its on-chain fee split."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Asset",
                "value": "GAS"
              },
              {
                "key": "Mode",
                "value": "Countdown jackpot"
              },
              {
                "key": "Timer",
                "value": "Contract-defined extension per key"
              },
              {
                "key": "Platform Fee",
                "value": "Contract-defined fee split"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How to play",
            "items": [
              "Connect your Neo N3 wallet and fund it with GAS.",
              "Transfer GAS to the contract — the amount covers one key at the current price.",
              "Each bid extends the timer. If you're the last bidder when it hits zero, the contract settles the pot by its on-chain fee split."
            ]
          }
        ]
      },
      {
        "id": "history",
        "label": "History",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Past rounds and their winners appear in the Live Round + Recent Winners panel on the play area above. Verify any round on NeoTube by opening the contract hash."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "LastSurvivor",
      "subtitle": "Buy keys while live; expired rounds are rolled forward automatically by the lifecycle keeper.",
      "cta_label": "Open LastSurvivor",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Fund Keys",
      "method": "fundGameCredit",
      "description": "Send GAS credit to the game contract before buying keys.",
      "button_style": "primary",
      "priority": "primary",
      "params": [
        {
          "name": "amount",
          "type": "amount",
          "label": "GAS credit",
          "required": true,
          "placeholder": "0.10",
          "scale": 8,
          "presets": [
            {
              "label": "0.10",
              "value": "0.10",
              "helper": "GAS"
            },
            {
              "label": "0.50",
              "value": "0.50",
              "helper": "GAS"
            },
            {
              "label": "1.00",
              "value": "1.00",
              "helper": "GAS"
            }
          ]
        }
      ]
    },
    {
      "name": "Buy Keys",
      "method": "buyCountdownKeys",
      "description": "Prepay GAS, buy keys for the active round, and extend the countdown.",
      "button_style": "primary",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-last-survivor",
          "hidden": true
        },
        {
          "name": "player",
          "type": "hash160",
          "label": "Player",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        },
        {
          "name": "keyCount",
          "type": "integer",
          "label": "Keys",
          "required": true,
          "default_value": "1",
          "placeholder": "1"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "daily_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/lastsurvivor",
  "detail_template": {
    "operation_panel": {
      "title": "LastSurvivor",
      "subtitle": "Buy keys while live; expired rounds are rolled forward automatically by the lifecycle keeper."
    }
  },
  "manifest": {
    "runtime": {
      "mode": "platform",
      "modules": [
        {
          "binding": "countdown-auction",
          "platform": "PlatformGame",
          "appId": "miniapp-last-survivor",
          "moduleType": 1,
          "registration": {
            "method": "registerGame",
            "type": 1
          },
          "operations": {
            "start_round": "startCountdownRound",
            "buy_keys": "buyCountdownKeys",
            "rollover": "checkAndEndCountdownRound",
            "status": "getCountdownStatus"
          },
          "networks": {
            "neo-n3-mainnet": {
              "contract_hash": "0xa7840a8d5404bbe297a00756a29cc267d6fa6cc7",
              "registered": true,
              "domain": "lastsurvivor.miniapp.neo"
            },
            "neo-n3-testnet": {
              "contract_hash": "0x740671b10330ef6669ab8b2724437eb8d5e7a34c",
              "registered": true
            }
          }
        }
      ]
    },
    "contracts": {
      "neo-n3-mainnet": "0xa7840a8d5404bbe297a00756a29cc267d6fa6cc7",
      "neo-n3-testnet": "0x740671b10330ef6669ab8b2724437eb8d5e7a34c"
    },
    "contract_domains": {
      "neo-n3-mainnet": "lastsurvivor.miniapp.neo"
    }
  }
}
