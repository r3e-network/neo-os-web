{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neo-miniapps.platform/schemas/miniapp-config.schema.json",
  "title": "MiniApp Configuration Schema",
  "description": "Schema for defining a template-driven MiniApp configuration",
  "type": "object",
  "required": ["app_id", "name", "template_type"],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 64,
      "description": "Unique identifier for the MiniApp"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Display name of the MiniApp"
    },
    "name_zh": {
      "type": "string",
      "maxLength": 128,
      "description": "Chinese display name"
    },
    "description": {
      "type": "string",
      "maxLength": 2048,
      "description": "Detailed description of the MiniApp"
    },
    "description_zh": {
      "type": "string",
      "maxLength": 2048,
      "description": "Chinese description"
    },
    "template_type": {
      "$ref": "#/definitions/template_type",
      "description": "Template type for the MiniApp"
    },
    "template": {
      "type": "object",
      "description": "Template metadata for frontend and contract templates",
      "properties": {
        "template_type": {
          "$ref": "#/definitions/template_type"
        },
        "frontend_template": {
          "$ref": "#/definitions/template_binding"
        },
        "frontend_composition": {
          "$ref": "#/definitions/frontend_composition"
        },
        "contract_template": {
          "$ref": "#/definitions/contract_template_binding"
        },
        "contract_composition": {
          "$ref": "#/definitions/contract_composition"
        }
      },
      "additionalProperties": true
    },
    "category": {
      "type": "string",
      "maxLength": 64,
      "description": "Category for filtering and organization"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 32
      },
      "maxItems": 10,
      "description": "Tags for search and filtering"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0",
      "description": "Version of the MiniApp configuration"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "pending", "active", "disabled"],
      "default": "draft",
      "description": "Lifecycle status of the MiniApp"
    },
    "developer": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "contract": {
      "type": "object",
      "description": "Contract configuration",
      "properties": {
        "template_id": {
          "type": "string",
          "description": "Template ID from MiniAppFactory"
        },
        "init_params": {
          "type": "object",
          "additionalProperties": true,
          "description": "Parameters passed to contract initialization"
        },
        "contract_hash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "description": "Deployed contract hash (if already deployed)"
        }
      }
    },
    "contract_template": {
      "description": "Contract template descriptor for template marketplace usage",
      "$ref": "#/definitions/contract_template_binding"
    },
    "contract_composition": {
      "description": "Shared/router/custom modular contract composition metadata",
      "$ref": "#/definitions/contract_composition"
    },
    "entry_url": {
      "type": "string",
      "description": "External entry URL for the MiniApp. Supports https://, mf://, or bare .matrix/.neo hostnames that will be normalized to https://.",
      "pattern": "^(?:mf://.+|https?://.+|(?:[a-z0-9-]+\\.)+(?:matrix|neo)(?::\\d+)?(?:[/?#].*)?|(?:localhost|127\\.0\\.0\\.1)(?::\\d+)?(?:[/?#].*)?)$"
    },
    "media": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string",
          "description": "URL or path to icon image"
        },
        "banner": {
          "type": "string",
          "description": "URL or path to banner image"
        },
        "logo": {
          "type": "string",
          "description": "URL or path to logo image"
        },
        "logo_variants": {
          "type": "array",
          "description": "Optional logo variants by theme/density",
          "items": { "$ref": "#/definitions/media_variant" }
        },
        "banner_variants": {
          "type": "array",
          "description": "Optional banner variants by theme/density/locale",
          "items": { "$ref": "#/definitions/media_variant" }
        }
      }
    },
    "frontend_template": {
      "description": "Frontend template descriptor for template marketplace usage",
      "$ref": "#/definitions/template_binding"
    },
    "frontend_composition": {
      "description": "Composable frontend runtime metadata for shared shell/slots/data recipes",
      "$ref": "#/definitions/frontend_composition"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "payments": { "type": "boolean", "default": false },
        "datafeed": { "type": "boolean", "default": false },
        "confidential": { "type": "boolean", "default": false },
        "governance": { "type": "boolean", "default": false },
        "storage": { "type": "boolean", "default": false },
        "oracle": { "type": "boolean", "default": false },
        "randomness": { "type": "boolean", "default": false },
        "aa": { "type": "boolean", "default": false },
        "cross_chain": { "type": "boolean", "default": false }
      },
      "default": {}
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_gas_per_tx": { "type": "string" },
        "daily_gas_cap_per_user": { "type": "string" },
        "governance_cap": { "type": "string" },
        "max_users": { "type": "integer" },
        "rate_limit": {
          "type": "object",
          "properties": {
            "requests_per_minute": { "type": "integer" },
            "requests_per_hour": { "type": "integer" }
          }
        }
      }
    },
    "frontend_spec": {
      "description": "Frontend template specification",
      "oneOf": [
        { "$ref": "#/definitions/frontend_spec" },
        { "type": "string" },
        {
          "type": "object",
          "required": ["content"],
          "properties": {
            "format": {
              "type": "string",
              "enum": ["markdown", "md", "yaml", "json"]
            },
            "content": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/operation"
      },
      "description": "Operations available in the operation panel"
    },
    "integration": {
      "type": "object",
      "properties": {
        "news_integration": { "type": "boolean", "default": true },
        "reviews_enabled": { "type": "boolean", "default": true },
        "forum_enabled": { "type": "boolean", "default": true },
        "activity_feed": { "type": "boolean", "default": true },
        "stats_display": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "docs_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to documentation"
    },
    "i18n": {
      "type": "object",
      "description": "Localized fields",
      "properties": {
        "name_en": { "type": "string", "maxLength": 128 },
        "description_en": { "type": "string", "maxLength": 2048 },
        "name_zh": { "type": "string", "maxLength": 128 },
        "description_zh": { "type": "string", "maxLength": 2048 }
      },
      "additionalProperties": true
    },
    "logic": {
      "type": "object",
      "description": "Declarative logic configuration for triggers/hooks/guards",
      "additionalProperties": true
    },
    "marketplace": {
      "type": "object",
      "description": "Marketplace publication and monetization metadata",
      "additionalProperties": true
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "type": { "type": "string", "enum": ["docs", "github", "twitter", "discord", "website", "other"] }
        },
        "required": ["label", "url"]
      }
    }
  },
  "definitions": {
    "template_type": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["prediction", "voting", "lottery", "auction", "defi", "nft", "gaming", "social", "tipping", "governance", "utility", "default"]
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 64
        }
      ]
    },
    "media_variant": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "theme": { "type": "string", "enum": ["light", "dark", "any"] },
        "density": { "type": "string", "enum": ["1x", "2x", "3x"] },
        "locale": { "type": "string", "maxLength": 16 }
      },
      "additionalProperties": false
    },
    "template_binding": {
      "type": "object",
      "properties": {
        "template_id": { "type": "string", "maxLength": 128 },
        "version": { "type": "string", "maxLength": 64 },
        "variant": { "type": "string", "maxLength": 64 },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "contract_template_binding": {
      "allOf": [
        { "$ref": "#/definitions/template_binding" },
        {
          "type": "object",
          "properties": {
            "init_params": {
              "type": "object",
              "additionalProperties": true
            },
            "init_schema": {
              "type": "object",
              "additionalProperties": true
            },
            "method_schema": {
              "type": "object",
              "additionalProperties": true
            },
            "security_profile": {
              "$ref": "#/definitions/contract_security_profile"
            },
            "factory_template_ref": { "type": "string", "maxLength": 256 },
            "requires_host_capability": {
              "type": "array",
              "description": "Host capabilities required by this contract template",
              "items": {
                "type": "string",
                "maxLength": 64
              },
              "maxItems": 32
            },
            "min_factory_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Minimum compatible contract factory version"
            },
            "max_factory_version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Maximum compatible contract factory version"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "contract_module_config": {
      "type": "object",
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "binding": { "type": "string" },
        "contract_hash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["module_id"],
      "additionalProperties": true
    },
    "contract_recipe_ref": {
      "type": "object",
      "properties": {
        "recipe_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      },
      "required": ["recipe_id"],
      "additionalProperties": true
    },
    "contract_composition": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["template", "shared", "router", "custom"]
        },
        "instance_id": { "type": "string", "minLength": 1 },
        "recipe": {
          "$ref": "#/definitions/contract_recipe_ref"
        },
        "modules": {
          "type": "array",
          "items": { "$ref": "#/definitions/contract_module_config" }
        },
        "router_template_ref": { "type": "string" },
        "registries": {
          "type": "object",
          "properties": {
            "module_registry": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            },
            "recipe_registry": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            },
            "instance_registry": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            }
          },
          "additionalProperties": true
        },
        "module_bindings": {
          "type": "object",
          "additionalProperties": true
        },
        "instance_permissions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "contract_security_profile": {
      "type": "object",
      "properties": {
        "upgradeable": { "type": "boolean" },
        "audited": { "type": "boolean" },
        "audit_provider": { "type": "string", "maxLength": 128 },
        "audit_hash": { "type": "string", "maxLength": 256 },
        "audit_date": { "type": "string", "description": "Audit publish date in YYYY-MM-DD" }
      },
      "additionalProperties": true
    },
    "frontend_composition": {
      "type": "object",
      "properties": {
        "shell_recipe": { "type": "string", "maxLength": 128 },
        "shell_version": { "type": "string", "maxLength": 64 },
        "surface_slots": {
          "type": "object",
          "additionalProperties": true
        },
        "data_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "operation_recipes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "style_profile": {
          "type": "object",
          "additionalProperties": true
        },
        "capability_bindings": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "frontend_spec": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["default", "prediction", "market", "gaming", "social"],
          "default": "default",
          "description": "Layout style for the detail page"
        },
        "hero": {
          "type": "object",
          "properties": {
            "eyebrow": { "type": "string", "description": "Small label above title" },
            "disclaimer": { "type": "string", "description": "Legal/important notice" }
          }
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tab"
          },
          "description": "Tabs for the left panel content"
        },
        "operation_panel": {
          "$ref": "#/definitions/operation_panel"
        }
      }
    },
    "tab": {
      "type": "object",
      "required": ["id", "label", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Unique tab identifier"
        },
        "label": {
          "type": "string",
          "description": "Display label for the tab"
        },
        "type": {
          "type": "string",
          "enum": ["content", "reviews", "forum", "news", "secrets"],
          "description": "Type of content in the tab"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/content_block"
          },
          "description": "Content blocks for content-type tabs"
        }
      }
    },
    "content_block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["markdown", "bullet_list", "key_value", "links", "notice"],
          "description": "Type of content block"
        },
        "title": {
          "type": "string",
          "description": "Optional title for the block"
        },
        "content": {
          "type": "string",
          "description": "Markdown content (for markdown/notice types)"
        },
        "items": {
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "string" },
              "description": "List items (for bullet_list type)"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": { "type": "string" },
                  "value": { "type": "string" }
                },
                "required": ["key", "value"]
              },
              "description": "Key-value items (for key_value type)"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "href": { "type": "string" },
                  "external": { "type": "boolean" }
                },
                "required": ["label", "href"]
              },
              "description": "Link items (for links type)"
            }
          ]
        },
        "tone": {
          "type": "string",
          "enum": ["info", "success", "warning"],
          "description": "Tone for notice blocks"
        }
      }
    },
    "operation_panel": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "default": "Operations",
          "description": "Title for the operation panel"
        },
        "subtitle": {
          "type": "string",
          "description": "Subtitle/description for the panel"
        },
        "cta_label": {
          "type": "string",
          "default": "Launch App",
          "description": "Label for the CTA button"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/operation"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "required": ["name", "method"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name for the operation"
        },
        "method": {
          "type": "string",
          "description": "Contract method to call"
        },
        "description": {
          "type": "string",
          "description": "Description of what the operation does"
        },
        "button_style": {
          "type": "string",
          "enum": ["primary", "secondary", "danger", "success"],
          "default": "primary"
        },
        "gas_cost": {
          "type": "string",
          "description": "Estimated GAS cost"
        },
        "confirm_message": {
          "type": "string",
          "description": "Confirmation message before executing"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/operation_param"
          }
        }
      }
    },
    "operation_param": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Parameter name (used in contract call)"
        },
        "type": {
          "type": "string",
          "enum": ["string", "integer", "boolean", "address", "hash160", "hash256", "amount", "select"],
          "description": "Parameter type"
        },
        "label": {
          "type": "string",
          "description": "Display label for the parameter"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "default_value": {
          "type": "string",
          "description": "Default value for the parameter"
        },
        "placeholder": {
          "type": "string",
          "description": "Placeholder text for input"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            },
            "required": ["label", "value"]
          },
          "description": "Options for select type parameters"
        }
      }
    }
  }
}
