{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-trustanchor",
  "name": "TrustAnchor",
  "description": "Stake NEO, redeem your stake, and claim GAS rewards while TrustAnchor operators manage the manual 21-agent AA voting route in a separate admin console.",
  "template_type": "governance",
  "category": "Governance",
  "tags": ["staking", "voting", "governance", "aa", "neo"],
  "version": "1.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "platform-anchor",
    "init_params": {
      "anchor_app_id": "miniapp-trustanchor",
      "mode": 1
    }
  },
  "entry_url": "mf://manifest?app=miniapp-trustanchor",
  "media": {
    "icon": "/miniapp-assets/trustanchor/logo.jpg",
    "banner": "/miniapp-assets/trustanchor/banner.jpg"
  },
  "permissions": {
    "payments": true,
    "governance": true,
    "aa": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "TrustAnchor"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "TrustAnchor is the user-facing staking app. Users only need to stake NEO, redeem NEO, and claim GAS rewards; operator routing is handled in TrustAnchor Admin."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Asset",
                "value": "NEO"
              },
              {
                "key": "User Actions",
                "value": "Stake / redeem / claim"
              },
              {
                "key": "Strategy",
                "value": "Manual operator route"
              },
              {
                "key": "Admin Routing",
                "value": "Separate console"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How it works",
            "items": [
              "Stake NEO to join the anchor and keep reward accounting tied to your wallet.",
              "Redeem withdraws your own stake; it does not expose or require agent routing knowledge.",
              "Claim rewards collects available GAS after operators distribute rewards."
            ]
          }
        ]
      },
      {
        "id": "operator",
        "label": "Operator model",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "TrustAnchor uses 21 AA agent accounts behind the scenes. Admins move NEO between agent accounts and update vote targets in TrustAnchor Admin, not in this user app."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Stake / Redeem / Claim",
      "subtitle": "The public app is for normal users. Admin routing lives in TrustAnchor Admin.",
      "cta_label": "Open TrustAnchor",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Stake NEO",
      "method": "stakeNeo",
      "button_style": "primary",
      "priority": "primary",
      "params": [
        {
          "name": "amount",
          "type": "integer",
          "label": "NEO",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Redeem NEO",
      "method": "withdrawNeo",
      "button_style": "secondary",
      "priority": "primary",
      "params": [
        {
          "name": "amount",
          "type": "integer",
          "label": "NEO",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Claim Rewards",
      "method": "claimRewards",
      "button_style": "success",
      "priority": "primary",
      "params": []
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "weekly_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/trustanchor"
}
