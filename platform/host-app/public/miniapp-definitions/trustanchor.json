{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-trustanchor",
  "name": "TrustAnchor",
  "description": "Manual 21-agent AA routing desk for trust-policy NEO voting. Operators rebalance between candidate agents and sync votes explicitly.",
  "template_type": "governance",
  "category": "Governance",
  "tags": ["staking", "voting", "governance", "aa", "neo"],
  "version": "1.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "platform-anchor",
    "init_params": {
      "anchor_app_id": "miniapp-trustanchor",
      "mode": 1
    }
  },
  "entry_url": "mf://manifest?app=miniapp-trustanchor",
  "media": {
    "icon": "/miniapp-assets/trustanchor/logo.jpg",
    "banner": "/miniapp-assets/trustanchor/banner.jpg"
  },
  "permissions": {
    "payments": true,
    "governance": true,
    "aa": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "TrustAnchor"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "TrustAnchor is an operator desk for explicit AA-agent routing. It does not auto-route funds; operators move NEO between candidate agents and sync votes deliberately."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Asset",
                "value": "NEO"
              },
              {
                "key": "Vote Identity",
                "value": "AA agent accounts"
              },
              {
                "key": "Routing",
                "value": "Manual"
              },
              {
                "key": "Agent Set",
                "value": "21 AA accounts"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How it works",
            "items": [
              "Each TrustAnchor instance owns its own 21 AA agent accounts, one per council candidate.",
              "Operators rebalance by transferring NEO from one agent account to another.",
              "When the candidate list changes, operators update an agent's vote target and then sync that agent vote."
            ]
          }
        ]
      },
      {
        "id": "agents",
        "label": "Agents",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Agent account, candidate public key, and verification hash are secondary diagnostics. The main operator flow stays move, update target, sync."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Stake / Withdraw / Claim",
      "subtitle": "Users manage their NEO stake here. Operator routing tools stay secondary.",
      "cta_label": "Open TrustAnchor",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Stake NEO",
      "method": "stakeNeo",
      "button_style": "primary",
      "priority": "primary",
      "params": [
        {
          "name": "amount",
          "type": "integer",
          "label": "NEO",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Withdraw NEO",
      "method": "withdrawNeo",
      "button_style": "secondary",
      "priority": "primary",
      "params": [
        {
          "name": "amount",
          "type": "integer",
          "label": "NEO",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Claim Rewards",
      "method": "claimRewards",
      "button_style": "success",
      "priority": "primary",
      "params": []
    },
    {
      "name": "Move NEO",
      "method": "transferAgentNeo",
      "button_style": "secondary",
      "priority": "operator",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-trustanchor",
          "hidden": true
        },
        {
          "name": "fromAgentId",
          "type": "integer",
          "label": "From agent",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "toAgentId",
          "type": "integer",
          "label": "To agent",
          "required": true,
          "placeholder": "2"
        },
        {
          "name": "amount",
          "type": "integer",
          "label": "NEO",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Update Vote Target",
      "method": "setAgentCandidate",
      "button_style": "secondary",
      "priority": "operator",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-trustanchor",
          "hidden": true
        },
        {
          "name": "agentId",
          "type": "integer",
          "label": "Agent",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "candidate",
          "type": "publickey",
          "label": "Candidate public key",
          "required": true,
          "placeholder": "02..."
        }
      ]
    },
    {
      "name": "Sync Vote",
      "method": "voteAgent",
      "button_style": "secondary",
      "priority": "operator",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-trustanchor",
          "hidden": true
        },
        {
          "name": "agentId",
          "type": "integer",
          "label": "Agent",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Register Agent",
      "method": "registerAgent",
      "button_style": "secondary",
      "priority": "operator",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-trustanchor",
          "hidden": true
        },
        {
          "name": "agentAccount",
          "type": "hash160",
          "label": "Agent account",
          "required": true,
          "placeholder": "0x..."
        },
        {
          "name": "candidate",
          "type": "publickey",
          "label": "Candidate public key",
          "required": true,
          "placeholder": "02..."
        },
        {
          "name": "verificationScriptHash",
          "type": "bytearray",
          "label": "Verification script hash",
          "required": true,
          "placeholder": "hex"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "weekly_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/trustanchor"
}
