{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "lottery-example",
  "name": "Weekly GAS Lottery",
  "description": "Participate in the weekly GAS lottery. 50% of ticket sales go to the prize pool, 50% are burned forever.",
  "template_type": "lottery",
  "category": "Gaming",
  "tags": ["lottery", "gas", "weekly"],
  "version": "1.0.0",
  "status": "active",
  "developer": {
    "name": "Neo Lottery",
    "email": "lottery@neo.org"
  },
  "contract": {
    "template_id": "lottery-scheduled",
    "init_params": {
      "ticket_price": 10,
      "draw_interval": 604800,
      "prize_distribution": "50/50",
      "max_tickets_per_user": 100
    }
  },
  "entry_url": "https://lottery.neo.org",
  "media": {
    "icon": "/miniapp-assets/lottery/icon.png",
    "banner": "/miniapp-assets/lottery/banner.png"
  },
  "permissions": {
    "payments": true,
    "randomness": true
  },
  "limits": {
    "max_gas_per_tx": "5",
    "daily_gas_cap_per_user": "50"
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "Weekly Lottery",
      "disclaimer": "Gambling can be addictive. Play responsibly."
    },
    "tabs": [
      {
        "id": "how-to-play",
        "label": "How to Play",
        "type": "content",
        "blocks": [
          {
            "type": "bullet_list",
            "title": "Rules",
            "items": [
              "Each ticket costs 10 GAS",
              "You can buy up to 100 tickets per draw",
              "Draws happen every Sunday at 00:00 UTC",
              "50% of ticket sales go to the prize pool",
              "50% of ticket sales are burned forever"
            ]
          },
          {
            "type": "key_value",
            "title": "Current Draw",
            "items": [
              { "key": "Ticket Price", "value": "10 GAS" },
              { "key": "Current Pool", "value": "1,234 GAS" },
              { "key": "Tickets Sold", "value": "247" },
              { "key": "Next Draw", "value": "2 days 14 hours" }
            ]
          }
        ]
      },
      {
        "id": "past-draws",
        "label": "Past Draws",
        "type": "content",
        "blocks": [
          {
            "type": "markdown",
            "content": "View past lottery results and winners."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Buy Tickets",
      "subtitle": "Purchase your lottery tickets for the next draw.",
      "cta_label": "View My Tickets",
      "operations": [
        {
          "name": "Buy Tickets",
          "method": "buyTickets",
          "description": "Purchase lottery tickets",
          "button_style": "primary",
          "gas_cost": "~0.3 GAS",
          "params": [
            {
              "name": "count",
              "type": "integer",
              "label": "Number of Tickets",
              "required": true,
              "default_value": "1",
              "placeholder": "1"
            }
          ]
        }
      ]
    }
  },
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": ["total_transactions", "total_gas_used"]
  },
  "docs_url": "https://docs.neo.org/lottery"
}
