{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "secret-vote",
  "name": "Secret Vote",
  "description": "Privacy-preserving on-chain voting using zero-knowledge proofs. Your vote remains confidential until the election ends.",
  "template_type": "voting",
  "category": "Governance",
  "tags": ["voting", "privacy", "zkp", "governance"],
  "version": "1.0.0",
  "status": "active",
  "developer": {
    "name": "Neo MiniApp Platform",
    "url": "https://r3e.network"
  },
  "contract": {
    "template_id": "voting-secret",
    "contract_hash": "0x9c5d8e4f3b2a1d0e7c6f9a8b7d6e5c4f3a2b1d0e"
  },
  "entry_url": "https://vote.r3e.network",
  "media": {
    "icon": "/miniapp-assets/secret-vote/icon.png",
    "banner": "/miniapp-assets/secret-vote/banner.png"
  },
  "permissions": {
    "governance": true,
    "confidential": true,
    "storage": true
  },
  "limits": {
    "max_gas_per_tx": "3",
    "governance_cap": "1000000"
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "Secret Voting",
      "disclaimer": "Your vote is encrypted and remains private until the voting period ends."
    },
    "tabs": [
      {
        "id": "proposal",
        "label": "Proposal",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "This voting system uses zero-knowledge proofs to ensure vote privacy while maintaining on-chain verifiability."
          },
          {
            "type": "key_value",
            "title": "Voting Info",
            "items": [
              { "key": "Voting Type", "value": "Secret Ballot" },
              { "key": "Privacy", "value": "ZK-based Encryption" },
              { "key": "Results", "value": "Revealed after voting ends" },
              { "key": "Verification", "value": "On-chain proof" }
            ]
          },
          {
            "type": "markdown",
            "title": "How Privacy Works",
            "content": "## Zero-Knowledge Voting\n\nYour vote is encrypted locally before being submitted on-chain. Only after the voting period ends are the aggregated results revealed.\n\n- **Vote Privacy**: No one can see how you voted\n- **Verifiability**: Anyone can verify the final tally\n- **Censorship Resistant**: Votes cannot be censored"
          }
        ]
      },
      {
        "id": "discussion",
        "label": "Discussion",
        "type": "forum"
      },
      {
        "id": "reviews",
        "label": "Feedback",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Cast Your Vote",
      "subtitle": "Your vote is private and encrypted.",
      "cta_label": "View All Proposals",
      "operations": [
        {
          "name": "Cast Vote",
          "method": "castVote",
          "description": "Submit your encrypted vote",
          "button_style": "primary",
          "gas_cost": "~0.5 GAS",
          "confirm_message": "Are you sure? Votes cannot be changed once submitted.",
          "params": [
            {
              "name": "choice",
              "type": "select",
              "label": "Your Vote",
              "required": true,
              "options": [
                { "label": "Yes", "value": "yes" },
                { "label": "No", "value": "no" },
                { "label": "Abstain", "value": "abstain" }
              ]
            }
          ]
        }
      ]
    }
  },
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": true,
    "activity_feed": true,
    "stats_display": ["total_users", "total_gas_used"]
  },
  "docs_url": "https://docs.r3e.network/secret-vote"
}
