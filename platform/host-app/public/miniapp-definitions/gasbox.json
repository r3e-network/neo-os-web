{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-gasbox",
  "name": "GASBOX",
  "description": "Ultra-low-cost GAS spins for chances to win NEO, rare NFTs, or points. Addictive gacha-style fun with provably fair randomness.",
  "template_type": "gaming",
  "category": "Gaming",
  "tags": [
    "gasbox",
    "gacha",
    "blind-box",
    "nft",
    "randomness"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "R3E Network",
    "url": "https://r3e.network"
  },
  "contract": {
    "template_id": "gaming-gasbox",
    "contract_hash": "0xf111a0d02ecae3ace271da8abeb7ee22fa122f1c"
  },
  "entry_url": "mf://manifest?app=miniapp-gasbox",
  "media": {
    "icon": "/miniapps/gasbox/logo.jpg",
    "banner": "/miniapps/gasbox/banner.jpg"
  },
  "permissions": {
    "payments": true,
    "randomness": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "GASBOX"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "GASBox is a two-step gacha. Pick a machine, initiate a pull, and wait for the VRF callback to reveal your prize. Each machine has its own prize pool with transparent drop rates."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Asset",
                "value": "GAS"
              },
              {
                "key": "Flow",
                "value": "initiate \u2192 VRF \u2192 settle"
              },
              {
                "key": "Randomness",
                "value": "Morpheus VRF"
              },
              {
                "key": "Drop Rates",
                "value": "On-chain, auditable per machine"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How to play",
            "items": [
              "Open the full GASBox app and browse the available machines.",
              "Pick a machine and transfer its entry cost in GAS to initiate a pull.",
              "Once the VRF callback lands, your prize is credited automatically \u2014 NFTs land in your wallet, GAS prizes land as balance."
            ]
          }
        ]
      },
      {
        "id": "machines",
        "label": "Machines",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Machines are configured by admins. Drop rates, item pools, and prices are on-chain and visible in the live play area above."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "GASBox",
      "subtitle": "Two-step VRF gacha. Use the full app to pick a machine and draw.",
      "cta_label": "Open GASBox",
      "operations": []
    }
  },
  "operations": [],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "weekly_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/gasbox",
  "detail_template": {
    "operation_panel": {
      "title": "GASBox",
      "subtitle": "Two-step VRF gacha. Use the full app to pick a machine and draw.",
      "cta_label": "Open GASBox",
      "operations": []
    }
  }
}