{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-gasbox",
  "name": "GASBOX",
  "description": "Ultra-low-cost GAS spins for chances to win NEO, rare NFTs, or points. Addictive gacha-style fun with provably fair randomness.",
  "template_type": "gaming",
  "category": "Gaming",
  "tags": [
    "gasbox",
    "gacha",
    "blind-box",
    "nft",
    "randomness"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "gaming-gasbox",
    "contract_hash": "0xa7840a8d5404bbe297a00756a29cc267d6fa6cc7"
  },
  "entry_url": "mf://manifest?app=miniapp-gasbox",
  "media": {
    "icon": "/miniapp-assets/gasbox/logo.jpg",
    "banner": "/miniapp-assets/gasbox/banner.jpg"
  },
  "permissions": {
    "payments": true,
    "randomness": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "GASBOX"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "GASBox is a two-step gacha. Pick a machine, initiate a pull, and wait for the VRF callback to reveal your prize. Each machine has its own prize pool with transparent drop rates."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Asset",
                "value": "GAS"
              },
              {
                "key": "Flow",
                "value": "initiate → VRF → settle"
              },
              {
                "key": "Randomness",
                "value": "Morpheus VRF"
              },
              {
                "key": "Drop Rates",
                "value": "On-chain, auditable per machine"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How to play",
            "items": [
              "Open the full GASBox app and browse the available machines.",
              "Pick a machine and transfer its entry cost in GAS to initiate a pull.",
              "Once the VRF callback lands, your prize is credited automatically — NFTs land in your wallet, GAS prizes land as balance."
            ]
          }
        ]
      },
      {
        "id": "machines",
        "label": "Machines",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Machines are configured by admins. Drop rates, item pools, and prices are on-chain and visible in the live play area above."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "GASBox",
      "subtitle": "Two-step VRF gacha. Use the full app to pick a machine and draw.",
      "cta_label": "Open GASBox",
      "operations": []
    }
  },
  "operations": [],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "weekly_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/gasbox",
  "detail_template": {
    "operation_panel": {
      "title": "GASBox",
      "subtitle": "Two-step VRF gacha. Use the full app to pick a machine and draw.",
      "cta_label": "Open GASBox",
      "operations": []
    }
  },
  "manifest": {
    "runtime": {
      "mode": "platform",
      "modules": [
        {
          "binding": "gacha",
          "platform": "PlatformGame",
          "appId": "miniapp-gasbox",
          "moduleType": 3,
          "registration": {
            "method": "registerGame",
            "type": 3
          },
          "operations": {
            "create_machine": "createGachaMachine",
            "pull": "pullGacha",
            "machine": "getGachaMachine"
          },
          "networks": {
            "neo-n3-mainnet": {
              "contract_hash": "0xa7840a8d5404bbe297a00756a29cc267d6fa6cc7",
              "registered": true,
              "domain": "gasbox.miniapp.neo"
            },
            "neo-n3-testnet": {
              "contract_hash": "0x740671b10330ef6669ab8b2724437eb8d5e7a34c",
              "registered": false
            }
          }
        }
      ]
    },
    "contracts": {
      "neo-n3-mainnet": "0xa7840a8d5404bbe297a00756a29cc267d6fa6cc7",
      "neo-n3-testnet": "0x49ec8536ba331d744a16b8da2a6ed4263ef4e89c"
    },
    "contract_domains": {
      "neo-n3-mainnet": "gasbox.miniapp.neo"
    }
  }
}
