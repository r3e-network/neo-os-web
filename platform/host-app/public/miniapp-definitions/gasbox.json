{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-gasbox",
  "name": "GASBOX",
  "description": "Ultra-low-cost GAS spins for chances to win NEO, rare NFTs, or points. Addictive gacha-style fun with provably fair randomness.",
  "template_type": "gaming",
  "category": "Gaming",
  "tags": [
    "gasbox",
    "gacha",
    "blind-box",
    "nft",
    "randomness"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "gaming-gasbox",
    "contract_hash": "0x30e9d4a4758827361c3b51a0e8460b067e58b1db"
  },
  "entry_url": "mf://manifest?app=miniapp-gasbox",
  "media": {
    "icon": "/miniapp-assets/gasbox/logo.webp",
    "banner": "/miniapp-assets/gasbox/banner.webp"
  },
  "permissions": {
    "payments": true,
    "randomness": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "GASBOX"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "GASBox is a two-step gacha. Pick a machine, place your bet, then reveal on the next block to draw your prize. Each machine has its own prize pool with transparent drop rates."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Asset",
                "value": "GAS"
              },
              {
                "key": "Flow",
                "value": "commit → next block → reveal"
              },
              {
                "key": "Randomness",
                "value": "On-chain commit/reveal (later-block randomness)"
              },
              {
                "key": "Drop Rates",
                "value": "On-chain, auditable per machine"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How to play",
            "items": [
              "Open the full GASBox app and browse the available machines.",
              "Pick a machine and pay its entry cost in GAS to place a bet — the outcome is fixed by a later block, so it can't be known or cancelled.",
              "Reveal on the next block to draw and receive your prize — GAS and NEO prizes land in your wallet automatically."
            ]
          }
        ]
      },
      {
        "id": "machines",
        "label": "Machines",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Machines are configured by admins. Drop rates, item pools, and prices are on-chain and visible in the live play area above."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "GASBox",
      "subtitle": "Two-step commit/reveal gacha. Use the full app to pick a machine, bet, then reveal.",
      "cta_label": "Open GASBox",
      "operations": []
    }
  },
  "operations": [],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "weekly_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/gasbox",
  "detail_template": {
    "operation_panel": {
      "title": "GASBox",
      "subtitle": "Two-step commit/reveal gacha. Use the full app to pick a machine, bet, then reveal.",
      "cta_label": "Open GASBox",
      "operations": []
    }
  },
  "manifest": {
    "runtime": {
      "mode": "platform",
      "modules": [
        {
          "binding": "gacha",
          "platform": "PlatformGame",
          "appId": "miniapp-gasbox",
          "moduleType": 3,
          "registration": {
            "method": "registerGame",
            "type": 3
          },
          "operations": {
            "create_machine": "createGachaMachine",
            "pull": "pullGacha",
            "machine": "getGachaMachine"
          },
          "networks": {
            "neo-n3-mainnet": {
              "contract_hash": "0x30e9d4a4758827361c3b51a0e8460b067e58b1db",
              "registered": true,
              "domain": "gasbox.miniapp.neo"
            },
            "neo-n3-testnet": {
              "contract_hash": "0x30e9d4a4758827361c3b51a0e8460b067e58b1db",
              "registered": true
            }
          }
        }
      ]
    },
    "contracts": {
      "neo-n3-mainnet": "0x30e9d4a4758827361c3b51a0e8460b067e58b1db",
      "neo-n3-testnet": "0x30e9d4a4758827361c3b51a0e8460b067e58b1db"
    },
    "contract_domains": {
      "neo-n3-mainnet": "gasbox.miniapp.neo"
    },
    "technologies": {
      "oracle": {
        "enabled": false,
        "description": "No off-chain oracle. The draw uses on-chain commit/reveal randomness (a later block's Runtime.GetRandom), settled by a permissionless reveal."
      },
      "vrf": {
        "enabled": true,
        "description": "Provably-fair on-chain randomness via commit/reveal: the outcome is fixed by a later block's Runtime.GetRandom, so it is unknowable at bet time and cannot be aborted on a loss"
      }
    }
  }
}
