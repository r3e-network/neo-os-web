{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-neo-pay",
  "name": "NeoPay",
  "description": "Recurring GAS or NEO payment streams with on-chain release schedules, beneficiary claims, and creator cancellation.",
  "template_type": "defi",
  "category": "DeFi",
  "tags": [
    "neopay",
    "payroll",
    "subscription",
    "streaming",
    "automation"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "R3E Network",
    "url": "https://r3e.network"
  },
  "contract": {
    "template_id": "defi-neopay",
    "contract_hash": "0xfd4dcc346d73c4ac6c3db209323561cf7f1b5e34"
  },
  "entry_url": "mf://manifest?app=miniapp-neo-pay",
  "media": {
    "icon": "/miniapps/neo-pay/logo.jpg",
    "banner": "/miniapps/neo-pay/banner.jpg"
  },
  "permissions": {
    "payments": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "NeoPay"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content"
      },
      {
        "id": "streams",
        "label": "Streams",
        "type": "content"
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Manage Streams",
      "subtitle": "Claim from incoming streams or cancel ones you created.",
      "cta_label": "Open NeoPay",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Claim Stream",
      "method": "claimStream",
      "button_style": "primary",
      "params": [
        {
          "name": "beneficiary",
          "type": "hash160",
          "label": "Beneficiary",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        },
        {
          "name": "streamId",
          "type": "integer",
          "label": "Stream ID",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Cancel Stream",
      "method": "cancelStream",
      "button_style": "danger",
      "params": [
        {
          "name": "creator",
          "type": "hash160",
          "label": "Creator",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        },
        {
          "name": "streamId",
          "type": "integer",
          "label": "Stream ID",
          "required": true,
          "placeholder": "1"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/neopay",
  "detail_template": {
    "operation_panel": {
      "title": "Manage Streams",
      "subtitle": "Claim from incoming streams or cancel ones you created."
    }
  }
}