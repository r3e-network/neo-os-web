{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-neo-pay",
  "name": "NeoPay",
  "description": "Recurring GAS or NEO payment streams with on-chain release schedules, beneficiary claims, and creator cancellation.",
  "template_type": "defi",
  "category": "DeFi",
  "tags": [
    "neopay",
    "payroll",
    "subscription",
    "streaming",
    "automation"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "defi-neopay",
    "contract_hash": "0xfd4dcc346d73c4ac6c3db209323561cf7f1b5e34"
  },
  "entry_url": "mf://manifest?app=miniapp-neo-pay",
  "media": {
    "icon": "/miniapp-assets/neo-pay/logo.jpg",
    "banner": "/miniapp-assets/neo-pay/banner.jpg"
  },
  "permissions": {
    "payments": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "NeoPay"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "NeoPay is on-chain payroll / subscriptions / vesting. Configure a total amount, release rate, interval, and beneficiary. Funds drip out per second on a deterministic schedule — recipients claim accrued amounts whenever they want."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Assets",
                "value": "GAS / NEO"
              },
              {
                "key": "Cadence",
                "value": "Per-second drip"
              },
              {
                "key": "Minimum Interval",
                "value": "86400 s (1 day)"
              },
              {
                "key": "Owner actions",
                "value": "Cancel anytime"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How to stream",
            "items": [
              "Fund the contract with the total amount you want to stream.",
              "Call createStream with beneficiary, amount, rate, interval, title, notes.",
              "Beneficiaries claim accrued amounts at will; creators can cancel and reclaim any unreleased balance."
            ]
          }
        ]
      },
      {
        "id": "streams",
        "label": "Streams",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Recent streams (beneficiary, released-vs-total, status) are visible in the live play area above."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Manage Streams",
      "subtitle": "Claim from incoming streams or cancel ones you created.",
      "cta_label": "Open NeoPay",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Claim Stream",
      "method": "claimStream",
      "button_style": "primary",
      "params": [
        {
          "name": "beneficiary",
          "type": "hash160",
          "label": "Beneficiary",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        },
        {
          "name": "streamId",
          "type": "integer",
          "label": "Stream ID",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Cancel Stream",
      "method": "cancelStream",
      "button_style": "danger",
      "params": [
        {
          "name": "creator",
          "type": "hash160",
          "label": "Creator",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        },
        {
          "name": "streamId",
          "type": "integer",
          "label": "Stream ID",
          "required": true,
          "placeholder": "1"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/neopay",
  "detail_template": {
    "operation_panel": {
      "title": "Manage Streams",
      "subtitle": "Claim from incoming streams or cancel ones you created."
    }
  }
}
