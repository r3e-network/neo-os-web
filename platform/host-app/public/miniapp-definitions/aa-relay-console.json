{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-aa-relay-console",
  "name": "AA Relay Console",
  "name_zh": "AA Relay 控制台",
  "description": "Prepare canonical AA relay review packages, import bound operator receipts, and verify UserOp outcomes on Neo N3.",
  "description_zh": "准备规范的 AA Relay 审核包，导入绑定的操作方回执，并在 Neo N3 上验证 UserOp 结果。",
  "template_type": "utility",
  "category": "utility",
  "tags": ["aa", "relay", "paymaster", "receipt", "recovery"],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "aa-relay-console",
    "contract_hash": "0x0268a387913b250166ddec032b03332690a1ef78",
    "domains": {
      "neo-n3-mainnet": "core.smartwallet.neo"
    }
  },
  "contract_domains": {
    "neo-n3-mainnet": "core.smartwallet.neo"
  },
  "entry_url": "mf://manifest?app=miniapp-aa-relay-console",
  "dapp_url": "/miniapps/aa-relay-console/index.html",
  "media": {
    "icon": "/miniapps/aa-relay-console/logo.webp",
    "banner": "/miniapps/aa-relay-console/banner.webp"
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "Account Abstraction"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "AA Relay Console prepares relay review packages, imports bound operator receipts, and verifies UserOp outcomes inside the embedded workspace."
          },
          {
            "type": "key_value",
            "title": "Runtime",
            "items": [
              {
                "key": "Mainnet domain",
                "value": "core.smartwallet.neo"
              },
              {
                "key": "Mode",
                "value": "Relay review packages and receipt verification"
              },
              {
                "key": "Transactions",
                "value": "None — read-only verification"
              }
            ]
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ]
  },
  "integration": {
    "news_integration": false,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": ["total_transactions", "daily_active_users"]
  },
  "manifest": {
    "contracts": {
      "neo-n3-mainnet": "0x0268a387913b250166ddec032b03332690a1ef78",
      "neo-n3-testnet": "0xdbf38e7b2117186bf7a5e17ead702322c0c5b6f2"
    },
    "contract_domains": {
      "neo-n3-mainnet": "core.smartwallet.neo"
    }
  }
}
