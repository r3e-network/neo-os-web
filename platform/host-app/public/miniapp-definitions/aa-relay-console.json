{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-aa-relay-console",
  "name": "AA Relay Console",
  "name_zh": "AA Relay 控制台",
  "description": "Prepare and validate sponsored account-abstraction relay packages before submission.",
  "description_zh": "在提交前准备并验证受赞助的账户抽象 relay 包。",
  "template_type": "utility",
  "category": "utility",
  "tags": ["aa", "relay", "paymaster", "sponsor"],
  "version": "1.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "email": "dev@r3e.network",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "aa-relay-console",
    "contract_hash": "0x0268a387913b250166ddec032b03332690a1ef78",
    "domains": {
      "neo-n3-mainnet": "core.smartwallet.neo"
    }
  },
  "contract_domains": {
    "neo-n3-mainnet": "core.smartwallet.neo"
  },
  "entry_url": "mf://manifest?app=miniapp-aa-relay-console",
  "dapp_url": "/miniapps/aa-relay-console/index.html",
  "media": {
    "icon": "/miniapps/aa-relay-console/logo.webp",
    "banner": "/miniapps/aa-relay-console/banner.webp"
  },
  "permissions": {
    "aa": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "Account Abstraction"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "AA Relay Console keeps relay package preparation, sponsor checks, and smart wallet context in one guarded workspace."
          },
          {
            "type": "key_value",
            "title": "Runtime",
            "items": [
              {
                "key": "Mainnet domain",
                "value": "core.smartwallet.neo"
              },
              {
                "key": "Mode",
                "value": "Relay package preparation"
              },
              {
                "key": "Transactions",
                "value": "Wallet guarded"
              }
            ]
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "AA Relay Console",
      "subtitle": "Check sponsor coverage, request paymaster support, then submit a relay-ready AA payload.",
      "cta_label": "Submit relay payload",
      "operations": [
        {
          "name": "Check Sponsorship",
          "method": "checkSponsor",
          "description": "Check whether this AA address is eligible for the selected paymaster scope.",
          "button_style": "secondary",
          "priority": "primary",
          "params": [
            {
              "name": "aaAddress",
              "type": "address",
              "label": "AA Address",
              "required": true
            },
            {
              "name": "dappId",
              "type": "string",
              "label": "Paymaster dApp ID",
              "default_value": "miniapp-aa-relay-console"
            }
          ]
        },
        {
          "name": "Request Sponsorship",
          "method": "requestSponsor",
          "description": "Request GAS sponsorship from the paymaster for this AA scope.",
          "button_style": "success",
          "priority": "primary",
          "params": [
            {
              "name": "aaAddress",
              "type": "address",
              "label": "AA Address",
              "required": true
            },
            {
              "name": "dappId",
              "type": "string",
              "label": "Paymaster dApp ID",
              "default_value": "miniapp-aa-relay-console"
            },
            {
              "name": "sponsorAmount",
              "type": "amount",
              "label": "Sponsor Amount",
              "default_value": "0.1",
              "required": true
            }
          ]
        },
        {
          "name": "Submit Relay Payload",
          "method": "submitRelay",
          "description": "Submit a relay-ready AA payload through the platform relay proxy.",
          "button_style": "primary",
          "priority": "primary",
          "confirm_message": "Submit this payload to the AA relay?",
          "params": [
            {
              "name": "aaAddress",
              "type": "address",
              "label": "AA Address",
              "required": true
            },
            {
              "name": "dappId",
              "type": "string",
              "label": "Paymaster dApp ID",
              "default_value": "miniapp-aa-relay-console"
            },
            {
              "name": "payloadJson",
              "type": "string",
              "label": "Relay Payload JSON",
              "default_value": "{\n  \"metaInvocation\": {\n    \"scriptHash\": \"0xdbf38e7b2117186bf7a5e17ead702322c0c5b6f2\"\n  }\n}",
              "required": true
            }
          ]
        }
      ]
    }
  },
  "operations": [
    {
      "name": "Check Sponsorship",
      "method": "checkSponsor",
      "description": "Check whether this AA address is eligible for the selected paymaster scope.",
      "button_style": "secondary",
      "priority": "primary",
      "params": [
        {
          "name": "aaAddress",
          "type": "address",
          "label": "AA Address",
          "required": true
        },
        {
          "name": "dappId",
          "type": "string",
          "label": "Paymaster dApp ID",
          "default_value": "miniapp-aa-relay-console"
        }
      ]
    },
    {
      "name": "Request Sponsorship",
      "method": "requestSponsor",
      "description": "Request GAS sponsorship from the paymaster for this AA scope.",
      "button_style": "success",
      "priority": "primary",
      "params": [
        {
          "name": "aaAddress",
          "type": "address",
          "label": "AA Address",
          "required": true
        },
        {
          "name": "dappId",
          "type": "string",
          "label": "Paymaster dApp ID",
          "default_value": "miniapp-aa-relay-console"
        },
        {
          "name": "sponsorAmount",
          "type": "amount",
          "label": "Sponsor Amount",
          "default_value": "0.1",
          "required": true
        }
      ]
    },
    {
      "name": "Submit Relay Payload",
      "method": "submitRelay",
      "description": "Submit a relay-ready AA payload through the platform relay proxy.",
      "button_style": "primary",
      "priority": "primary",
      "confirm_message": "Submit this payload to the AA relay?",
      "params": [
        {
          "name": "aaAddress",
          "type": "address",
          "label": "AA Address",
          "required": true
        },
        {
          "name": "dappId",
          "type": "string",
          "label": "Paymaster dApp ID",
          "default_value": "miniapp-aa-relay-console"
        },
        {
          "name": "payloadJson",
          "type": "string",
          "label": "Relay Payload JSON",
          "default_value": "{\n  \"metaInvocation\": {\n    \"scriptHash\": \"0xdbf38e7b2117186bf7a5e17ead702322c0c5b6f2\"\n  }\n}",
          "required": true
        }
      ]
    }
  ],
  "integration": {
    "news_integration": false,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": ["total_transactions", "daily_active_users"]
  },
  "manifest": {
    "runtime": {
      "mode": "dedicated",
      "modules": []
    },
    "contracts": {
      "neo-n3-mainnet": "0x0268a387913b250166ddec032b03332690a1ef78",
      "neo-n3-testnet": "0xdbf38e7b2117186bf7a5e17ead702322c0c5b6f2"
    },
    "contract_domains": {
      "neo-n3-mainnet": "core.smartwallet.neo"
    }
  }
}
