{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-neo-pay-shared-example",
  "name": "NeoPay Shared Mode Example",
  "description": "Example bundled definition showing how NeoPay can be registered in shared mode using funding_vault + stream_vesting instead of a bespoke business contract.",
  "template_type": "defi",
  "category": "DeFi",
  "tags": [
    "neopay",
    "shared-mode",
    "recipe",
    "streaming",
    "example"
  ],
  "version": "0.1.0",
  "status": "draft",
  "developer": {
    "name": "R3E Network",
    "url": "https://r3e.network"
  },
  "contract_composition": {
    "mode": "shared",
    "instance_id": "neopay:testnet:default",
    "registries": {
      "module_registry": "0x7666a46644dca58e8c3b308b34e83db440e04991",
      "recipe_registry": "0xe22bc8072f616974a64c0da1dfda845945d4215f",
      "instance_registry": "0x5b9a6d1ca5fdbc95d4307990551682a3b7a1d5d6"
    },
    "recipe": {
      "recipe_id": "recipe.payment_streams.v1",
      "version": "1.0.0"
    },
    "modules": [
      {
        "module_id": "module.funding_vault",
        "version": "1.0.0",
        "binding": "vault",
        "config": {
          "accepted_assets": [
            "0xef4073a0f2b305a38ec4050e4d3d28bc40ea63f5",
            "0xd2a4cff31913016155e38e474a2c06d08be276cf"
          ],
          "deposit_mode": "direct_nep17_credit",
          "allow_creator_refund": true
        }
      },
      {
        "module_id": "module.stream_vesting",
        "version": "1.0.0",
        "binding": "stream",
        "depends_on": ["vault"],
        "config": {
          "min_interval_seconds": 86400,
          "max_interval_seconds": 31536000,
          "max_title_length": 60,
          "max_notes_length": 240,
          "supports_creator_cancel": true,
          "supports_beneficiary_claim": true
        }
      }
    ],
    "module_bindings": {
      "vault": {
        "module_id": "module.funding_vault",
        "version": "1.0.0"
      },
      "stream": {
        "module_id": "module.stream_vesting",
        "version": "1.0.0"
      }
    },
    "instance_permissions": {
      "oracle": false,
      "automation": false,
      "escrow_assets": ["NEO", "GAS"]
    }
  },
  "frontend_composition": {
    "shell_recipe": "shell.launcher.v1",
    "shell_version": "1.0.0",
    "surface_slots": {
      "hero": "hero.streams.v1",
      "operation_panel": "panel.stream_builder.v1",
      "stats": "stats.stream_summary.v1",
      "activity": "ticker.stream_activity.v1"
    },
    "data_sources": [
      {
        "id": "shared_runtime",
        "type": "shared_mode_runtime",
        "instance_id": "neopay:testnet:default"
      },
      {
        "id": "stream_module",
        "type": "contract_read",
        "binding": "stream",
        "method": "totalStreams",
        "args": ["neopay:testnet:default"]
      }
    ],
    "operation_recipes": [
      {
        "id": "create_stream",
        "operation": "createSharedStream",
        "binding": "stream",
        "method": "createStream",
        "args": [
          { "source": "instance.instanceId", "type": "String" },
          { "source": "wallet.address", "type": "Hash160" },
          { "source": "input.beneficiary", "type": "Hash160" },
          { "source": "input.asset", "type": "Hash160" },
          { "source": "input.totalAmount", "type": "Integer", "scale": 8 },
          { "source": "input.rateAmount", "type": "Integer", "scale": 8 },
          { "source": "input.intervalSeconds", "type": "Integer" },
          { "source": "input.title", "type": "String" },
          { "source": "input.notes", "type": "String" }
        ]
      },
      {
        "id": "claim_stream",
        "operation": "claimSharedStream",
        "binding": "stream",
        "method": "claimStream",
        "args": [
          { "source": "instance.instanceId", "type": "String" },
          { "source": "wallet.address", "type": "Hash160" },
          { "source": "input.streamId", "type": "Integer" }
        ]
      },
      {
        "id": "cancel_stream",
        "operation": "cancelSharedStream",
        "binding": "stream",
        "method": "cancelStream",
        "args": [
          { "source": "instance.instanceId", "type": "String" },
          { "source": "wallet.address", "type": "Hash160" },
          { "source": "input.streamId", "type": "Integer" }
        ]
      }
    ],
    "style_profile": {
      "theme_family": "finance",
      "density": "compact",
      "tone": "professional"
    },
    "capability_bindings": {
      "shared_runtime": "contract_composition",
      "wallet": "neo_n3_wallet"
    }
  },
  "entry_url": "mf://manifest?app=miniapp-neo-pay",
  "media": {
    "icon": "/miniapps/neo-pay/logo.jpg",
    "banner": "/miniapps/neo-pay/banner.jpg"
  },
  "permissions": {
    "payments": true
  },
  "operations": [
    {
      "name": "Create Stream",
      "method": "createSharedStream",
      "description": "Create a shared-mode payment stream backed by the shared stream_vesting module.",
      "button_style": "primary",
      "params": [
        {
          "name": "beneficiary",
          "type": "address",
          "label": "Beneficiary Address",
          "required": true,
          "placeholder": "Neo N3 address"
        },
        {
          "name": "asset",
          "type": "select",
          "label": "Asset",
          "required": true,
          "default_value": "0xd2a4cff31913016155e38e474a2c06d08be276cf",
          "options": [
            {
              "label": "GAS",
              "value": "0xd2a4cff31913016155e38e474a2c06d08be276cf"
            },
            {
              "label": "NEO",
              "value": "0xef4073a0f2b305a38ec4050e4d3d28bc40ea63f5"
            }
          ]
        },
        {
          "name": "totalAmount",
          "type": "amount",
          "label": "Total Amount",
          "required": true,
          "placeholder": "20"
        },
        {
          "name": "rateAmount",
          "type": "amount",
          "label": "Release Per Interval",
          "required": true,
          "placeholder": "1.5"
        },
        {
          "name": "intervalSeconds",
          "type": "select",
          "label": "Interval",
          "required": true,
          "default_value": "2592000",
          "options": [
            {
              "label": "Weekly",
              "value": "604800"
            },
            {
              "label": "Monthly",
              "value": "2592000"
            },
            {
              "label": "Quarterly",
              "value": "7776000"
            }
          ]
        },
        {
          "name": "title",
          "type": "string",
          "label": "Stream Name",
          "required": true,
          "placeholder": "Monthly payroll stream"
        },
        {
          "name": "notes",
          "type": "string",
          "label": "Notes",
          "required": false,
          "placeholder": "Optional context"
        }
      ]
    },
    {
      "name": "Claim Stream",
      "method": "claimSharedStream",
      "description": "Claim unlocked funds from an existing shared-mode stream.",
      "button_style": "secondary",
      "params": [
        {
          "name": "streamId",
          "type": "integer",
          "label": "Stream ID",
          "required": true,
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Cancel Stream",
      "method": "cancelSharedStream",
      "description": "Cancel an existing shared-mode stream and refund the locked remainder.",
      "button_style": "danger",
      "params": [
        {
          "name": "streamId",
          "type": "integer",
          "label": "Stream ID",
          "required": true,
          "placeholder": "1"
        }
      ]
    }
  ],
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "NeoPay Shared Mode"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content"
      },
      {
        "id": "streams",
        "label": "Streams",
        "type": "content"
      }
    ],
    "operation_panel": {
      "title": "Create Shared Stream",
      "subtitle": "Registry-driven recurring streams using shared modules.",
      "cta_label": "Open NeoPay",
      "operations": []
    }
  }
}
