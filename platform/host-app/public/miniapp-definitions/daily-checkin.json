{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-dailycheckin",
  "name": "Daily Check-in",
  "description": "Check in every day to earn GAS rewards with streak bonuses. 7-day streak earns 1 GAS, 14-day streak earns 2 GAS, plus loyalty NFT badges.",
  "template_type": "gaming",
  "category": "Gaming",
  "tags": [
    "daily-checkin",
    "streaks",
    "rewards",
    "badges",
    "nft-badges"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "gaming-daily-checkin",
    "contract_hash": "0xbd4f3646e189350b9c11a659655854e6f03f9be4"
  },
  "entry_url": "mf://manifest?app=miniapp-dailycheckin",
  "media": {
    "icon": "/miniapp-assets/daily-checkin/logo.jpg",
    "banner": "/miniapp-assets/daily-checkin/banner.jpg"
  },
  "permissions": {
    "payments": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "Daily Check-in"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "success",
            "content": "Show up once per UTC day to keep your streak alive. At the 7-day milestone you claim a GAS bonus and unlock loyalty NFT badges. Miss a day and the streak resets."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Fee",
                "value": "0.001 GAS per check-in"
              },
              {
                "key": "Streak Reset",
                "value": "After 14 days of inactivity"
              },
              {
                "key": "7-Day Reward",
                "value": "1 GAS"
              },
              {
                "key": "14-Day Reward",
                "value": "2 GAS"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How to play",
            "items": [
              "Connect your wallet once per UTC day.",
              "Tap Check In — a tiny fee transfer books your day on-chain.",
              "Keep the streak going to unlock escalating GAS rewards and NFT loyalty badges."
            ]
          }
        ]
      },
      {
        "id": "streak",
        "label": "Streak",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Your current streak and check-in history live on-chain. Every check-in emits a CheckedIn event that you can verify via the contract hash on NeoTube."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Daily Check-in",
      "subtitle": "One tap per UTC day to maintain your streak.",
      "cta_label": "Open Daily Check-in",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Check In",
      "method": "checkIn",
      "button_style": "primary",
      "params": [
        {
          "name": "user",
          "type": "hash160",
          "label": "User",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        }
      ]
    },
    {
      "name": "Claim Rewards",
      "method": "claimRewards",
      "button_style": "secondary",
      "params": [
        {
          "name": "user",
          "type": "hash160",
          "label": "User",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "daily_active_users",
      "weekly_active_users",
      "total_transactions"
    ]
  },
  "docs_url": "https://docs.r3e.network/daily-check-in",
  "detail_template": {
    "operation_panel": {
      "title": "Daily Check-in",
      "subtitle": "One tap per UTC day to maintain your streak."
    }
  }
}
