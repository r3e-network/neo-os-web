{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "red-envelope",
  "name": "Red Envelope",
  "description": "Send and receive red envelopes (hongbao) filled with GAS. A fun way to share wealth on special occasions.",
  "template_type": "tipping",
  "category": "Social",
  "tags": ["red-envelope", "hongbao", "tipping", "social", "gift"],
  "version": "1.0.0",
  "status": "active",
  "developer": {
    "name": "Neo MiniApp Platform",
    "url": "https://r3e.network"
  },
  "contract": {
    "template_id": "tipping-red-envelope",
    "contract_hash": "0xa1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0"
  },
  "entry_url": "https://red-envelope.r3e.network",
  "media": {
    "icon": "/miniapp-assets/red-envelope/icon.png",
    "banner": "/miniapp-assets/red-envelope/banner.png"
  },
  "permissions": {
    "payments": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "Red Envelope",
      "disclaimer": "Red envelopes are final and cannot be reclaimed once claimed by recipients."
    },
    "tabs": [
      {
        "id": "how-it-works",
        "label": "How It Works",
        "type": "content",
        "blocks": [
          {
            "type": "bullet_list",
            "title": "Creating a Red Envelope",
            "items": [
              "Set the total amount of GAS to share",
              "Choose how many people can claim",
              "Share the envelope link or code",
              "Recipients claim their share randomly"
            ]
          },
          {
            "type": "key_value",
            "title": "Envelope Types",
            "items": [
              { "key": "Random", "value": "Amount varies per claim" },
              { "key": "Fixed", "value": "Same amount for everyone" },
              { "key": "Lucky", "value": "One person gets the full amount" }
            ]
          },
          {
            "type": "markdown",
            "title": "Cultural Significance",
            "content": "## Red Envelopes (Hongbao)\n\nIn Chinese culture, red envelopes symbolize good luck and are traditionally given during holidays and special occasions. This on-chain version brings the tradition to the blockchain!"
          }
        ]
      },
      {
        "id": "my-envelopes",
        "label": "My Envelopes",
        "type": "content",
        "blocks": [
          {
            "type": "markdown",
            "content": "View all red envelopes you've sent and received."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Create Red Envelope",
      "subtitle": "Share GAS with friends and family.",
      "cta_label": "View My Envelopes",
      "operations": [
        {
          "name": "Create Random",
          "method": "createRandom",
          "description": "Random amounts for each claimant",
          "button_style": "primary",
          "gas_cost": "~0.3 GAS",
          "params": [
            {
              "name": "totalAmount",
              "type": "amount",
              "label": "Total Amount (GAS)",
              "required": true,
              "placeholder": "100.0"
            },
            {
              "name": "claimCount",
              "type": "integer",
              "label": "Number of Claims",
              "required": true,
              "placeholder": "10"
            }
          ]
        },
        {
          "name": "Create Fixed",
          "method": "createFixed",
          "description": "Same amount for everyone",
          "button_style": "secondary",
          "gas_cost": "~0.3 GAS",
          "params": [
            {
              "name": "amountPerClaim",
              "type": "amount",
              "label": "Amount Per Claim (GAS)",
              "required": true,
              "placeholder": "10.0"
            },
            {
              "name": "claimCount",
              "type": "integer",
              "label": "Number of Claims",
              "required": true,
              "placeholder": "10"
            }
          ]
        },
        {
          "name": "Claim",
          "method": "claim",
          "description": "Claim a red envelope",
          "button_style": "primary",
          "gas_cost": "~0.2 GAS",
          "params": [
            {
              "name": "envelopeId",
              "type": "string",
              "label": "Envelope ID or Code",
              "required": true,
              "placeholder": "Enter code..."
            }
          ]
        }
      ]
    }
  },
  "integration": {
    "news_integration": false,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": ["total_transactions", "total_gas_used"]
  },
  "docs_url": "https://docs.r3e.network/red-envelope"
}
