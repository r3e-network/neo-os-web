{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-redenvelope",
  "name": "Red Envelope",
  "description": "Create equal-split or lucky-draw GAS envelopes, protect them with share codes, and track claims on-chain.",
  "template_type": "social",
  "category": "Social",
  "tags": [
    "red-envelope",
    "hongbao",
    "viral",
    "sharing",
    "gift"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "R3E Network",
    "url": "https://r3e.network"
  },
  "contract": {
    "template_id": "social-red-envelope",
    "contract_hash": "0x4079c09a0ff121fc44d817c37d6ae8694b268e9f"
  },
  "entry_url": "mf://manifest?app=miniapp-redenvelope",
  "media": {
    "icon": "/miniapps/red-envelope/logo.jpg",
    "banner": "/miniapps/red-envelope/banner.jpg"
  },
  "permissions": {
    "payments": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "Red Envelope"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content"
      },
      {
        "id": "claims",
        "label": "Claims",
        "type": "content"
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Create Envelope",
      "subtitle": "Create social gifting links and manage claims directly on-chain.",
      "cta_label": "Open Red Envelope",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Create Envelope",
      "method": "createEnvelope",
      "button_style": "primary",
      "params": [
        {
          "name": "totalAmount",
          "type": "amount",
          "label": "Total Amount (GAS)",
          "required": true,
          "placeholder": "10"
        },
        {
          "name": "packetCount",
          "type": "integer",
          "label": "Packet Count",
          "required": true,
          "placeholder": "10"
        }
      ]
    },
    {
      "name": "Claim",
      "method": "claim",
      "button_style": "secondary",
      "params": [
        {
          "name": "envelopeId",
          "type": "string",
          "label": "Envelope ID",
          "required": true,
          "placeholder": "Enter code"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "daily_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/red-envelope"
}
