{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-redenvelope",
  "name": "Red Envelope",
  "description": "Create equal-split or lucky-draw GAS envelopes, protect them with share codes, and track claims on-chain.",
  "template_type": "social",
  "category": "Social",
  "tags": ["red-envelope", "hongbao", "viral", "sharing", "gift"],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "social-red-envelope",
    "contract_hash": "0x5f371cc50116bb13d79554d96ccdd6e246cd5d59"
  },
  "entry_url": "mf://manifest?app=miniapp-redenvelope",
  "media": {
    "icon": "/miniapp-assets/red-envelope/logo.jpg",
    "banner": "/miniapp-assets/red-envelope/banner.jpg"
  },
  "permissions": {
    "payments": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "Red Envelope"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "success",
            "content": "Red Envelope turns GAS gifting into a lucky draw. Wrap GAS into a packet, set how many recipients can claim, and share the envelope ID. Each claimer pulls a random share through VRF until the envelope is empty."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Asset",
                "value": "GAS"
              },
              {
                "key": "Mode",
                "value": "Lucky packets"
              },
              {
                "key": "Randomness",
                "value": "Morpheus VRF"
              },
              {
                "key": "Recipients",
                "value": "Any address with the envelope ID"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How to use",
            "items": [
              "Create an envelope: set total GAS and how many packets (claimers) you want.",
              "Share the envelope ID with recipients — anyone with the ID can claim once.",
              "Each claim pulls a random share until all packets are taken or the envelope expires."
            ]
          }
        ]
      },
      {
        "id": "claims",
        "label": "Claims",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "The Recent Envelopes list above shows envelopes created on-chain with their creator, claimed-vs-total packets, and GAS remaining."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Claim Envelope",
      "subtitle": "Claim is the primary action. Sending a new envelope is available as a secondary operation.",
      "cta_label": "Open Red Envelope",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Claim",
      "method": "claimEnvelope",
      "button_style": "primary",
      "priority": "primary",
      "params": [
        {
          "name": "envelopeId",
          "type": "integer",
          "label": "Envelope ID",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "claimer",
          "type": "hash160",
          "label": "Claimer",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        }
      ]
    },
    {
      "name": "Create",
      "method": "createEnvelope",
      "button_style": "secondary",
      "priority": "secondary",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-redenvelope",
          "hidden": true
        },
        {
          "name": "creator",
          "type": "hash160",
          "label": "Creator",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        },
        {
          "name": "amount",
          "type": "amount",
          "label": "Total GAS",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "packetCount",
          "type": "integer",
          "label": "Recipients",
          "required": true,
          "placeholder": "8"
        },
        {
          "name": "expirySeconds",
          "type": "integer",
          "label": "Expires in seconds",
          "required": true,
          "placeholder": "86400"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "daily_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/red-envelope",
  "detail_template": {
    "operation_panel": {
      "title": "Claim Envelope",
      "subtitle": "Claim is the primary action. Sending a new envelope is available as a secondary operation.",
      "cta_label": "Open Red Envelope",
      "operations": []
    }
  }
}
