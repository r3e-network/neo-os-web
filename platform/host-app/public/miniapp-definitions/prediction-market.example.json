{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "prediction-market-example",
  "name": "Election 2028 Market",
  "description": "Predict the outcome of the 2028 presidential election. Will the incumbent party win?",
  "template_type": "prediction",
  "category": "Politics",
  "tags": ["politics", "election", "binary"],
  "version": "1.0.0",
  "status": "active",
  "developer": {
    "name": "Neo Markets",
    "email": "contact@neomarkets.io",
    "url": "https://neomarkets.io"
  },
  "contract": {
    "template_id": "prediction-binary",
    "init_params": {
      "oracle": "0x1234567890abcdef1234567890abcdef12345678",
      "outcome_count": 2,
      "settlement_timestamp": 1855622400,
      "fee_bps": 100
    }
  },
  "entry_url": "https://app.neomarkets.io/election-2028",
  "media": {
    "icon": "/miniapp-assets/prediction-market/icon.png",
    "banner": "/miniapp-assets/prediction-market/banner.png"
  },
  "permissions": {
    "payments": true,
    "datafeed": true,
    "oracle": true
  },
  "limits": {
    "max_gas_per_tx": "10",
    "daily_gas_cap_per_user": "100"
  },
  "frontend_spec": {
    "layout": "prediction",
    "hero": {
      "eyebrow": "Prediction Market",
      "disclaimer": "Prices imply probabilities, not guarantees. Trade responsibly."
    },
    "tabs": [
      {
        "id": "market-info",
        "label": "Market Info",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Settlement is controlled by market oracle rules. Results will be final 24 hours after the election."
          },
          {
            "type": "key_value",
            "title": "Market Facts",
            "items": [
              { "key": "Market Type", "value": "Binary" },
              { "key": "Asset", "value": "GAS" },
              { "key": "Settlement Date", "value": "Nov 8, 2028" },
              { "key": "Trading Fee", "value": "1%" }
            ]
          },
          {
            "type": "markdown",
            "title": "Resolution Rules",
            "content": "This market resolves based on the official certification of election results. If the incumbent party's candidate wins, YES shares resolve to $1. Otherwise, NO shares resolve to $1."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      },
      {
        "id": "forum",
        "label": "Discussion",
        "type": "forum"
      },
      {
        "id": "news",
        "label": "Activity",
        "type": "news"
      }
    ],
    "operation_panel": {
      "title": "Trade Position",
      "subtitle": "Select your position and stake amount.",
      "cta_label": "Open Full Experience",
      "operations": [
        {
          "name": "Buy YES",
          "method": "buyYes",
          "description": "Buy YES shares if you believe this outcome will happen",
          "button_style": "primary",
          "gas_cost": "~0.5 GAS",
          "params": [
            {
              "name": "amount",
              "type": "amount",
              "label": "Stake Amount (GAS)",
              "required": true,
              "placeholder": "10.0"
            }
          ]
        },
        {
          "name": "Buy NO",
          "method": "buyNo",
          "description": "Buy NO shares if you believe this outcome won't happen",
          "button_style": "secondary",
          "gas_cost": "~0.5 GAS",
          "params": [
            {
              "name": "amount",
              "type": "amount",
              "label": "Stake Amount (GAS)",
              "required": true,
              "placeholder": "10.0"
            }
          ]
        },
        {
          "name": "Sell Position",
          "method": "sellShares",
          "description": "Sell your existing position",
          "button_style": "danger",
          "gas_cost": "~0.5 GAS",
          "params": [
            {
              "name": "side",
              "type": "select",
              "label": "Position to Sell",
              "required": true,
              "options": [
                { "label": "YES Shares", "value": "yes" },
                { "label": "NO Shares", "value": "no" }
              ]
            },
            {
              "name": "amount",
              "type": "amount",
              "label": "Shares to Sell",
              "required": true,
              "placeholder": "10.0"
            }
          ]
        }
      ]
    }
  },
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": true,
    "activity_feed": true,
    "stats_display": ["total_transactions", "daily_active_users", "total_gas_used"]
  },
  "docs_url": "https://docs.neomarkets.io",
  "links": [
    { "label": "Documentation", "url": "https://docs.neomarkets.io", "type": "docs" },
    { "label": "GitHub", "url": "https://github.com/neomarkets", "type": "github" },
    { "label": "Twitter", "url": "https://twitter.com/neomarkets", "type": "twitter" }
  ]
}
