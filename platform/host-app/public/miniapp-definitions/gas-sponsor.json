{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "gas-sponsor",
  "name": "Gas Sponsor",
  "description": "Sponsor GAS fees for specific contracts or users, enabling gasless transactions.",
  "template_type": "utility",
  "category": "Utility",
  "tags": [
    "gas",
    "sponsor",
    "fee",
    "utility"
  ],
  "version": "1.0.0",
  "status": "active",
  "developer": {
    "name": "Neo MiniApp Platform",
    "url": "https://r3e.network"
  },
  "contract": {
    "template_id": "utility-sponsor",
    "init_params": {
      "max_sponsorship_per_tx": 10,
      "daily_limit": 10000
    }
  },
  "permissions": {
    "payments": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "Gas Sponsorship",
      "disclaimer": "Sponsored transactions are limited by your sponsorship pool balance."
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Sponsor GAS fees for users of your dApp or specific contracts, enabling gasless transactions."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Category",
                "value": "Utility"
              },
              {
                "key": "Asset",
                "value": "GAS"
              },
              {
                "key": "Type",
                "value": "Fee Sponsorship"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How It Works",
            "items": [
              "Deposit GAS into your sponsorship pool.",
              "Configure which contracts or users to sponsor.",
              "Sponsored users can transact without paying GAS."
            ]
          }
        ]
      },
      {
        "id": "sponsors",
        "label": "Sponsors",
        "type": "content",
        "blocks": [
          {
            "type": "markdown",
            "content": "View active sponsorship configurations and usage statistics."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Manage Sponsorship",
      "subtitle": "Deposit or configure your sponsorship settings.",
      "cta_label": "View Dashboard",
      "operations": [
        {
          "name": "Create Pool",
          "method": "createPool",
          "description": "Create an on-chain GAS sponsorship pool after funding the contract.",
          "button_style": "primary",
          "gas_cost": "~0.1 GAS",
          "params": [
            {
              "name": "sponsor",
              "type": "hash160",
              "label": "Sponsor",
              "required": true,
              "default_value": "$wallet",
              "hidden": true
            },
            {
              "name": "totalBudget",
              "type": "amount",
              "label": "Total Budget (GAS fractions)",
              "required": true,
              "placeholder": "100000000"
            },
            {
              "name": "perUserLimit",
              "type": "amount",
              "label": "Per-user Limit (GAS fractions)",
              "required": true,
              "placeholder": "10000000"
            },
            {
              "name": "expiresAt",
              "type": "integer",
              "label": "Expiry Timestamp",
              "required": true,
              "placeholder": "1893456000"
            },
            {
              "name": "metadata",
              "type": "string",
              "label": "Metadata",
              "required": false,
              "placeholder": "MiniApp sponsorship pool"
            }
          ]
        },
        {
          "name": "Claim Sponsorship",
          "method": "claimSponsorship",
          "description": "Claim a sponsored GAS allowance from an active pool.",
          "button_style": "secondary",
          "params": [
            {
              "name": "beneficiary",
              "type": "hash160",
              "label": "Beneficiary",
              "required": true,
              "default_value": "$wallet",
              "hidden": true
            },
            {
              "name": "poolId",
              "type": "integer",
              "label": "Pool ID",
              "required": true,
              "placeholder": "1"
            },
            {
              "name": "amount",
              "type": "amount",
              "label": "Claim Amount (GAS fractions)",
              "required": true,
              "placeholder": "1000000"
            }
          ]
        },
        {
          "name": "Withdraw Pool",
          "method": "withdrawPool",
          "description": "Withdraw remaining GAS from a pool you sponsor.",
          "button_style": "danger",
          "params": [
            {
              "name": "sponsor",
              "type": "hash160",
              "label": "Sponsor",
              "required": true,
              "default_value": "$wallet",
              "hidden": true
            },
            {
              "name": "poolId",
              "type": "integer",
              "label": "Pool ID",
              "required": true,
              "placeholder": "1"
            }
          ]
        }
      ]
    }
  },
  "integration": {
    "news_integration": false,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/gas-sponsor",
  "media": {
    "icon": "/miniapp-assets/gas-sponsor/logo.jpg",
    "banner": "/miniapp-assets/gas-sponsor/banner.jpg"
  }
}
