{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "gas-sponsor",
  "name": "Gas Sponsor",
  "description": "Create, discover and operate transparent on-chain GAS sponsorship pools.",
  "template_type": "utility",
  "category": "Utility",
  "tags": [
    "gas",
    "sponsor",
    "fee",
    "utility"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "utility-sponsor",
    "init_params": {
      "pool_type": 1,
      "min_sponsorship_gas": 1,
      "max_claim_per_tx_gas": 0.1
    }
  },
  "permissions": {
    "payments": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "Gas Sponsorship",
      "disclaimer": "Every pool balance, allowance, expiry and claim is read from the deployed contract."
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Browse public pools before connecting a wallet, then claim a small GAS allowance or open a transparent community pool."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Category",
                "value": "Utility"
              },
              {
                "key": "Asset",
                "value": "GAS"
              },
              {
                "key": "Type",
                "value": "Fee Sponsorship"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How It Works",
            "items": [
              "Choose a live public pool and inspect its real remaining balance.",
              "Claim within the pool's per-wallet and per-transaction limits.",
              "Sponsors can create, top up, extend or withdraw their own pools."
            ]
          }
        ]
      },
      {
        "id": "sponsors",
        "label": "Sponsors",
        "type": "content",
        "blocks": [
          {
            "type": "markdown",
            "content": "View active sponsorship configurations and usage statistics."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Community Refill Station",
      "subtitle": "Use the designed MiniApp station to browse, claim, sponsor and manage pools without a generic parameter form.",
      "cta_label": "Open Station",
      "operations": []
    }
  },
  "integration": {
    "news_integration": false,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/gas-sponsor",
  "media": {
    "icon": "/miniapp-assets/gas-sponsor/logo.webp",
    "banner": "/miniapp-assets/gas-sponsor/banner.webp"
  }
}
