{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-fogplay",
  "name": "FogPlay",
  "description": "Fast oracle-backed coin flips with on-chain settlement and direct GAS wagering.",
  "template_type": "gaming",
  "category": "Gaming",
  "tags": [
    "fogplay",
    "fogplay",
    "oracle",
    "betting",
    "gas"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "R3E Network",
    "url": "https://r3e.network"
  },
  "contract": {
    "template_id": "gaming-fogplay",
    "contract_hash": "0xa5a4b5b82066d86eae9312f6072d1c3604882c81"
  },
  "entry_url": "mf://manifest?app=miniapp-fogplay",
  "media": {
    "icon": "/miniapps/fogplay/logo.jpg",
    "banner": "/miniapps/fogplay/banner.jpg"
  },
  "permissions": {
    "payments": true,
    "randomness": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "FogPlay"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "FogPlay is a provably-fair coin flip. Pick a side, lock a stake, and settle via the Morpheus VRF oracle. Win and walk away with 2\u00d7 your stake."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Asset",
                "value": "GAS"
              },
              {
                "key": "Payout",
                "value": "2\u00d7 on win"
              },
              {
                "key": "Randomness",
                "value": "Morpheus VRF"
              },
              {
                "key": "Settlement",
                "value": "On-chain oracle callback"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How to play",
            "items": [
              "Pick Heads or Tails and set your wager (0.05 \u2013 100 GAS).",
              "Transfer your GAS to the contract \u2014 an oracle request fires automatically.",
              "Once the VRF callback lands, the result is posted on-chain and winners claim their 2\u00d7 payout."
            ]
          }
        ]
      },
      {
        "id": "history",
        "label": "History",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Every flip is recorded on-chain. Inspect individual bets by opening the contract on NeoTube \u2014 notifications carry bet id, player, amount, and outcome."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Place Bet",
      "subtitle": "Pick a side, set your wager, flip \u2014 2x payout.",
      "cta_label": "Open FogPlay",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Flip",
      "method": "placeBet",
      "button_style": "primary",
      "params": [
        {
          "name": "player",
          "type": "hash160",
          "label": "Player",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        },
        {
          "name": "amount",
          "type": "amount",
          "label": "Wager (GAS)",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "choice",
          "type": "boolean",
          "label": "Heads",
          "required": true,
          "default_value": "true"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "daily_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/fogplay",
  "detail_template": {
    "operation_panel": {
      "title": "Place Bet",
      "subtitle": "Pick a side, set your wager, flip \u2014 2x payout."
    }
  }
}