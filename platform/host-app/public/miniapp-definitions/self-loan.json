{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-self-loan",
  "name": "SelfLoan",
  "description": "Lock NEO to borrow GAS against future staking rewards. Collateral can follow the currently selected ProfitAnchor manual route while staying in SelfLoan custody.",
  "template_type": "defi",
  "category": "DeFi",
  "tags": [
    "self-loan",
    "lending",
    "neo",
    "gas",
    "profitanchor"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "Yiwu",
    "url": "https://neomini.app"
  },
  "contract": {
    "template_id": "defi-self-loan",
    "contract_hash": "0x87f94598c78cb954ca8200d3964ded9b584d7250"
  },
  "entry_url": "mf://manifest?app=miniapp-self-loan",
  "media": {
    "icon": "/miniapp-assets/self-loan/logo.jpg",
    "banner": "/miniapp-assets/self-loan/banner.jpg"
  },
  "permissions": {
    "payments": true,
    "governance": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "SelfLoan"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "SelfLoan lets you unlock GAS from your NEO holdings without liquidation risk. Lock NEO, borrow GAS up front, and let the collateral follow ProfitAnchor's selected manual route while it stays inside SelfLoan custody."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Collateral",
                "value": "NEO"
              },
              {
                "key": "Borrow Asset",
                "value": "GAS"
              },
              {
                "key": "LTV Tiers",
                "value": "20% · 30% · 40%"
              },
              {
                "key": "Liquidation",
                "value": "None - yield repays"
              },
              {
                "key": "Vote Signal",
                "value": "ProfitAnchor"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How it works",
            "items": [
              "Transfer NEO to the contract as collateral.",
              "Pick an LTV tier (1 = conservative, 3 = aggressive) and call createLoan to draw GAS.",
              "SelfLoan can sync collateralized NEO voting to ProfitAnchor's selected route without transferring collateral custody.",
              "NEO staking rewards flow to the contract and repay the debt. Once repaid, the NEO is released back to you."
            ]
          }
        ]
      },
      {
        "id": "loans",
        "label": "Loans",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Recent loans (borrower, collateral, debt, open/repaid) are visible in the live play area above. Loan health and repay progress are on-chain."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Manage Loan",
      "subtitle": "Create a funded testnet loan, repay debt, or top up collateral.",
      "cta_label": "Open SelfLoan",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Create Loan",
      "method": "createLoan",
      "button_style": "primary",
      "priority": "primary",
      "description": "Locks whole NEO as collateral and calls PlatformDeFi createLoan in the same wallet transaction. Testnet can include a small GAS liquidity top-up so the loan can settle.",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-self-loan",
          "hidden": true
        },
        {
          "name": "borrower",
          "type": "hash160",
          "label": "Borrower",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        },
        {
          "name": "collateralNeo",
          "type": "integer",
          "label": "Collateral NEO",
          "required": true,
          "default_value": "1",
          "placeholder": "1",
          "presets": [
            {
              "label": "1 NEO",
              "value": "1",
              "helper": "min"
            },
            {
              "label": "3 NEO",
              "value": "3"
            },
            {
              "label": "5 NEO",
              "value": "5"
            }
          ]
        },
        {
          "name": "ltvTier",
          "type": "select",
          "label": "LTV Tier",
          "required": true,
          "default_value": "1",
          "options": [
            {
              "label": "Tier 1 · 20%",
              "value": "1"
            },
            {
              "label": "Tier 2 · 30%",
              "value": "2"
            },
            {
              "label": "Tier 3 · 40%",
              "value": "3"
            }
          ]
        },
        {
          "name": "poolTopupGas",
          "type": "amount",
          "label": "Liquidity Top-up GAS",
          "required": false,
          "default_value": "0.30",
          "placeholder": "0.30",
          "scale": 8
        }
      ]
    },
    {
      "name": "Repay Loan",
      "method": "repayLoan",
      "button_style": "primary",
      "priority": "primary",
      "description": "Prepays GAS to the SelfLoan credit ledger and calls repayLoan for the selected loan.",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-self-loan",
          "hidden": true
        },
        {
          "name": "loanId",
          "type": "integer",
          "label": "Loan ID",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "repayGas",
          "type": "amount",
          "label": "Repay GAS",
          "required": true,
          "default_value": "0.25",
          "placeholder": "0.25",
          "scale": 8
        }
      ]
    },
    {
      "name": "Add Collateral",
      "method": "addCollateral",
      "button_style": "secondary",
      "priority": "secondary",
      "description": "Transfers additional whole NEO collateral and applies it to an active loan.",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-self-loan",
          "hidden": true
        },
        {
          "name": "loanId",
          "type": "integer",
          "label": "Loan ID",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "collateralNeo",
          "type": "integer",
          "label": "Additional NEO",
          "required": true,
          "default_value": "1",
          "placeholder": "1"
        }
      ]
    },
    {
      "name": "Sync Anchor Vote",
      "method": "syncProfitAnchorVote",
      "button_style": "secondary",
      "priority": "operator",
      "description": "Syncs SelfLoan collateral voting to the ProfitAnchor selected route when the runtime has been configured.",
      "params": [
        {
          "name": "appId",
          "type": "string",
          "label": "App ID",
          "required": true,
          "default_value": "miniapp-self-loan",
          "hidden": true
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "weekly_active_users",
      "total_gas_used"
    ]
  },
  "logic": {
    "depends_on": [
      "miniapp-profitanchor"
    ],
    "uses": [
      "profitanchor.selectedCandidate"
    ]
  },
  "docs_url": "https://docs.r3e.network/self-loan",
  "detail_template": {
    "operation_panel": {
      "title": "Manage Loan",
      "subtitle": "Create a funded testnet loan, repay debt, or top up collateral."
    }
  }
}
