{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-self-loan",
  "name": "SelfLoan",
  "description": "Lock NEO to borrow GAS against future staking rewards. Collateral can follow ProfitAnchor's best-profit vote signal while staying in SelfLoan custody.",
  "template_type": "defi",
  "category": "DeFi",
  "tags": [
    "self-loan",
    "lending",
    "neo",
    "gas",
    "profitanchor"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "R3E Network",
    "url": "https://r3e.network"
  },
  "contract": {
    "template_id": "defi-self-loan",
    "contract_hash": "0x942da575b31f39cbb59e64b5813b128739b44c25"
  },
  "entry_url": "mf://manifest?app=miniapp-self-loan",
  "media": {
    "icon": "/miniapp-assets/self-loan/logo.jpg",
    "banner": "/miniapp-assets/self-loan/banner.jpg"
  },
  "permissions": {
    "payments": true,
    "governance": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "SelfLoan"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "SelfLoan lets you unlock GAS from your NEO holdings without liquidation risk. Lock NEO, borrow GAS up front, and let the collateral follow ProfitAnchor's best-profit vote signal while it stays inside SelfLoan custody."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Collateral",
                "value": "NEO"
              },
              {
                "key": "Borrow Asset",
                "value": "GAS"
              },
              {
                "key": "LTV Tiers",
                "value": "20% · 30% · 40%"
              },
              {
                "key": "Liquidation",
                "value": "None - yield repays"
              },
              {
                "key": "Vote Signal",
                "value": "ProfitAnchor"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How it works",
            "items": [
              "Transfer NEO to the contract as collateral.",
              "Pick an LTV tier (1 = conservative, 3 = aggressive) and call createLoan to draw GAS.",
              "SelfLoan can sync collateralized NEO voting to ProfitAnchor's best candidate without transferring collateral custody.",
              "NEO staking rewards flow to the contract and repay the debt. Once repaid, the NEO is released back to you."
            ]
          }
        ]
      },
      {
        "id": "loans",
        "label": "Loans",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Recent loans (borrower, collateral, debt, open/repaid) are visible in the live play area above. Loan health and repay progress are on-chain."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Manage Loan",
      "subtitle": "Repay debt or top up collateral on an existing loan.",
      "cta_label": "Open SelfLoan",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Repay Debt",
      "method": "repayDebt",
      "button_style": "primary",
      "params": [
        {
          "name": "loanId",
          "type": "integer",
          "label": "Loan ID",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "payer",
          "type": "hash160",
          "label": "Payer",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        },
        {
          "name": "amount",
          "type": "amount",
          "label": "Repay Amount (GAS)",
          "required": true,
          "placeholder": "1"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "weekly_active_users",
      "total_gas_used"
    ]
  },
  "logic": {
    "depends_on": [
      "miniapp-profitanchor"
    ],
    "uses": [
      "profitanchor.bestCandidate"
    ]
  },
  "docs_url": "https://docs.r3e.network/self-loan",
  "detail_template": {
    "operation_panel": {
      "title": "Manage Loan",
      "subtitle": "Repay debt or top up collateral on an existing loan."
    }
  }
}
