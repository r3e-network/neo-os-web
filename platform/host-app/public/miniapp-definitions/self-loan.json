{
  "$schema": "./miniapp-config.schema.json",
  "app_id": "miniapp-self-loan",
  "name": "SelfLoan",
  "description": "Lock NEO to borrow GAS against future staking rewards. NEO stays locked until generated GAS plus fee repays the loan, then auto-unlocks.",
  "template_type": "defi",
  "category": "DeFi",
  "tags": [
    "self-loan",
    "lending",
    "neo",
    "gas",
    "yield"
  ],
  "version": "2.0.0",
  "status": "active",
  "developer": {
    "name": "R3E Network",
    "url": "https://r3e.network"
  },
  "contract": {
    "template_id": "defi-self-loan",
    "contract_hash": "0x942da575b31f39cbb59e64b5813b128739b44c25"
  },
  "entry_url": "mf://manifest?app=miniapp-self-loan",
  "media": {
    "icon": "/miniapps/self-loan/logo.jpg",
    "banner": "/miniapps/self-loan/banner.jpg"
  },
  "permissions": {
    "payments": true
  },
  "frontend_spec": {
    "layout": "default",
    "hero": {
      "eyebrow": "SelfLoan"
    },
    "tabs": [
      {
        "id": "overview",
        "label": "Overview",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "SelfLoan lets you unlock GAS from your NEO holdings without liquidation risk. Lock NEO, borrow GAS up front, and the NEO yield slowly repays the loan. NEO unlocks automatically once the debt is cleared."
          },
          {
            "type": "key_value",
            "title": "Quick Facts",
            "items": [
              {
                "key": "Collateral",
                "value": "NEO"
              },
              {
                "key": "Borrow Asset",
                "value": "GAS"
              },
              {
                "key": "LTV Tiers",
                "value": "20% \u00b7 30% \u00b7 40%"
              },
              {
                "key": "Liquidation",
                "value": "None \u2014 yield repays"
              }
            ]
          },
          {
            "type": "bullet_list",
            "title": "How it works",
            "items": [
              "Transfer NEO to the contract as collateral.",
              "Pick an LTV tier (1 = conservative, 3 = aggressive) and call createLoan to draw GAS.",
              "NEO staking rewards flow to the contract and repay the debt. Once repaid, the NEO is released back to you."
            ]
          }
        ]
      },
      {
        "id": "loans",
        "label": "Loans",
        "type": "content",
        "blocks": [
          {
            "type": "notice",
            "tone": "info",
            "content": "Recent loans (borrower, collateral, debt, open/repaid) are visible in the live play area above. Loan health and repay progress are on-chain."
          }
        ]
      },
      {
        "id": "reviews",
        "label": "Reviews",
        "type": "reviews"
      }
    ],
    "operation_panel": {
      "title": "Manage Loan",
      "subtitle": "Repay debt or top up collateral on an existing loan.",
      "cta_label": "Open SelfLoan",
      "operations": []
    }
  },
  "operations": [
    {
      "name": "Repay Debt",
      "method": "repayDebt",
      "button_style": "primary",
      "params": [
        {
          "name": "loanId",
          "type": "integer",
          "label": "Loan ID",
          "required": true,
          "placeholder": "1"
        },
        {
          "name": "payer",
          "type": "hash160",
          "label": "Payer",
          "required": true,
          "default_value": "$wallet",
          "hidden": true
        },
        {
          "name": "amount",
          "type": "amount",
          "label": "Repay Amount (GAS)",
          "required": true,
          "placeholder": "1"
        }
      ]
    }
  ],
  "integration": {
    "news_integration": true,
    "reviews_enabled": true,
    "forum_enabled": false,
    "activity_feed": true,
    "stats_display": [
      "total_transactions",
      "weekly_active_users",
      "total_gas_used"
    ]
  },
  "docs_url": "https://docs.r3e.network/self-loan",
  "detail_template": {
    "operation_panel": {
      "title": "Manage Loan",
      "subtitle": "Repay debt or top up collateral on an existing loan."
    }
  }
}