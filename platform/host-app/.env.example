# Sentry error reporting (leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=

# PostHog analytics (leave blank to disable)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional public CDN/R2 base for MiniApp media.
# When set, /miniapp-assets/<app>/<file> is loaded from this base instead of
# the host app deployment artifact. Do not put secrets in NEXT_PUBLIC_* values.
# NEXT_PUBLIC_MINIAPP_MEDIA_PUBLIC_BASE_URL=https://media.example.com

# Protected cron endpoints.
CRON_SECRET=

# Optional relayer used by /api/cron/miniapp-lifecycle for automatic
# PlatformGame lifecycle maintenance. The signer stays in the relayer/runtime.
MINIAPP_LIFECYCLE_RELAYER_URL=
MINIAPP_LIFECYCLE_RELAYER_TOKEN=
