{
  "Marbles": {
    "globalsigner": {
      "MaxActivations": 100,
      "Package": "globalsigner",
      "Parameters": {
        "Argv": [
          "./service"
        ],
        "Env": {
          "EDG_MARBLE_TYPE": "globalsigner",
          "GLOBALSIGNER_DOMAIN_ALLOWLIST": "neocompute:*,txproxy:*,neosimulation:*,neogasbank:*,neooracle:*,neorequests:*,neovrf:*,neofeeds:*,neoflow:*,neoaccounts:*,globalsigner:*",
          "GLOBALSIGNER_MASTER_SEED": "{{ hex .Secrets.GLOBALSIGNER_MASTER_SEED.Private }}",
          "GLOBALSIGNER_REQUIRE_QUOTE": "false",
          "GLOBALSIGNER_SERVICE_URL": "https://globalsigner:8092",
          "GLOBALSIGNER_SIGN_RAW_ALLOWLIST": "neocompute,txproxy,neosimulation,neogasbank,neooracle,neorequests,neovrf,neofeeds,neoflow,neoaccounts,globalsigner",
          "MARBLE_CERT": "{{ pem .MarbleRun.MarbleCert.Cert }}",
          "MARBLE_EXTRA_CLIENT_CA": "",
          "MARBLE_KEY": "{{ pem .MarbleRun.MarbleCert.Private }}",
          "MARBLE_ROOT_CA": "{{ pem .MarbleRun.RootCA.Cert }}",
          "NEO_RPC_URL": "http://localhost:30333",
          "SERVICE_TYPE": "globalsigner"
        }
      }
    },
