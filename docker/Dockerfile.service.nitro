# syntax=docker/dockerfile:1.7
# =============================================================================
# Service Dockerfile (AWS Nitro / non-EGo runtime)
# =============================================================================

ARG GO_VERSION=1.24
ARG SERVICE=marble

FROM golang:${GO_VERSION}-bookworm AS builder

ARG SERVICE

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/service ./cmd/marble

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/service /app/service

# Default backend for this image family; can be overridden at runtime.
ENV TEE_BACKEND=nitro

ENTRYPOINT ["/app/service"]
