# =============================================================================
# Supabase Secrets Template
# Copy to secrets.yaml locally or run deploy/scripts/supabase-k3s.sh.
# DO NOT commit real secret values.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: supabase-secrets
  namespace: supabase
type: Opaque
stringData:
  POSTGRES_PASSWORD: "replace-with-generated-password"
  DATABASE_URL: "postgresql://postgres:replace-with-generated-password@postgres.supabase.svc.cluster.local:5432/postgres"
  JWT_SECRET: "replace-with-generated-jwt-secret"
  ANON_KEY: "replace-with-generated-anon-jwt"
  SERVICE_ROLE_KEY: "replace-with-generated-service-role-jwt"
