{
  "name": "NeoPay Shared Mode Example",
  "blueprint_kind": "shared_recipe_instance_plan",
  "blueprint_version": "1.0.0",
  "blueprint_profile": {
    "goal": "show the minimum operator-resolved plan needed to publish a no-code MiniApp without writing a bespoke contract",
    "suitable_for": [
      "single-recipe shared-mode apps",
      "apps whose actions can call one shared module at a time",
      "operator-approved frontend + contract blueprints"
    ],
    "user_editable_fields": [
      "definition_path",
      "recipe.recipe_id",
      "recipe.version",
      "instance.instance_id",
      "instance.owner",
      "instance.developer",
      "instance.frontend_ref",
      "modules[*].config",
      "instance.module_bindings",
      "recipe.required_fields",
      "recipe.operation_schema"
    ],
    "operator_managed_fields": [
      "rpc_url",
      "module_registry_hash",
      "recipe_registry_hash",
      "instance_registry_hash",
      "app_registry_hash",
      "modules[*].contract_hash",
      "modules[*].init_schema_hash",
      "modules[*].operation_schema_hash",
      "instance.config_hash"
    ],
    "mode_rules": [
      "shared mode keeps instance.router_contract empty",
      "recipe.allowed_runtime_mode must match instance.runtime_mode",
      "instance.module_bindings keys must cover every recipe.module_refs[*].binding",
      "frontend_ref should point to a pre-approved shell/profile version"
    ]
  },
  "publish_workflow": [
    "1. Author or update the miniapp definition referenced by definition_path.",
    "2. Fill only the user-editable fields in this plan from the approved recipe blueprint.",
    "3. Resolve registry hashes and module contract hashes from the operator catalog, not from end-user input.",
    "4. Run go run -tags=scripts deploy/scripts/register_modular_instance.go --plan <this-file> --validate-only.",
    "5. If validation passes, rerun with --dry-run or without it to register modules, recipe, and instance."
  ],
  "definition_path": "platform/host-app/public/miniapp-definitions/neo-pay.shared.json",
  "rpc_url": "https://testnet2.neo.coz.io:443",
  "module_registry_hash": "0x7666a46644dca58e8c3b308b34e83db440e04991",
  "recipe_registry_hash": "0xe22bc8072f616974a64c0da1dfda845945d4215f",
  "instance_registry_hash": "0x5b9a6d1ca5fdbc95d4307990551682a3b7a1d5d6",
  "app_registry_hash": "0x9ceaabb583a9261b34380a9df2d32a75c1c04a3d",
  "link_registries": true,
  "modules": [
    {
      "module_id": "module.funding_vault",
      "version": "1.0.0",
      "binding": "vault",
      "contract_hash": "0x958bccb2ec9292461977ef1d2f1222d4e7861537",
      "init_schema_hash": "",
      "operation_schema_hash": "",
      "risk_profile": "custody",
      "compatibility_metadata": {
        "accepted_assets": ["NEO", "GAS"]
      },
      "active": true
    },
    {
      "module_id": "module.stream_vesting",
      "version": "1.0.0",
      "binding": "stream",
      "contract_hash": "0x4fa6544b133457b561e4f9db0248483eca3d33cf",
      "init_schema_hash": "",
      "operation_schema_hash": "",
      "risk_profile": "payments",
      "compatibility_metadata": {
        "recipe": "recipe.payment_streams.v1"
      },
      "active": true
    }
  ],
  "recipe": {
    "recipe_id": "recipe.payment_streams.v1",
    "version": "1.0.0",
    "module_refs": [
      { "module_id": "module.funding_vault", "version": "1.0.0", "binding": "vault" },
      { "module_id": "module.stream_vesting", "version": "1.0.0", "binding": "stream" }
    ],
    "required_fields": {
      "instance_permissions": ["escrow_assets"],
      "module_bindings": ["vault", "stream"]
    },
    "operation_schema": {
      "actions": ["createStream", "claimStream", "cancelStream"]
    },
    "allowed_runtime_mode": "shared",
    "router_template_id": "",
    "compatibility_metadata": {
      "app_id": "miniapp-neo-pay"
    },
    "active": true
  },
  "instance": {
    "instance_id": "neopay:testnet:default",
    "app_id": "miniapp-neo-pay",
    "recipe_id": "recipe.payment_streams.v1",
    "recipe_version": "1.0.0",
    "runtime_mode": "shared",
    "owner": "NR3E4D8NUXh3zhbf5ZkAp3rTxWbQqNih32",
    "operator": "",
    "developer": "NR3E4D8NUXh3zhbf5ZkAp3rTxWbQqNih32",
    "router_contract": "",
    "module_bindings": {
      "vault": {
        "module_id": "module.funding_vault",
        "version": "1.0.0"
      },
      "stream": {
        "module_id": "module.stream_vesting",
        "version": "1.0.0"
      }
    },
    "config_hash": "",
    "frontend_ref": "miniapp-neo-pay@2.0.0"
  }
}
