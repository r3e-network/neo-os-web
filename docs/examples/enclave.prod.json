{
  "exe": "nitro",
  "key": "private.pem",
  "debug": false,
  "heapSize": 512,
  "productID": 1,
  "securityVersion": 1,
  "mounts": [
    {
      "source": "/etc/ssl/certs",
      "target": "/etc/ssl/certs",
      "type": "hostfs",
      "readOnly": true
    }
  ],
  "env": [
    { "name": "SERVICE_TYPE", "fromHost": true },
    { "name": "NITRO_TYPE", "fromHost": true },
    { "name": "NITRO_CERT", "fromHost": true },
    { "name": "NITRO_KEY", "fromHost": true },
    { "name": "NITRO_ROOT_CA", "fromHost": true },
    { "name": "NITRO_UUID", "fromHost": true },
    { "name": "NITRO_SECRETS", "fromHost": true },
    { "name": "SUPABASE_URL", "fromHost": true },
    { "name": "SUPABASE_SERVICE_KEY", "fromHost": true },
    { "name": "NEO_RPC_URL", "fromHost": true },
    { "name": "GASBANK_DEPOSIT_ADDRESS", "fromHost": true },
    { "name": "PORT", "fromHost": true }
  ],
  "files": [
    {
      "source": "/etc/ssl/certs/ca-certificates.crt",
      "target": "/etc/ssl/certs/ca-certificates.crt"
    }
  ]
}
