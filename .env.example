CONTRACT_STORAGESERVICE_HASH=0x59d3e03b12f5803fb0b2b18e6f2211e2d0354d70
CONTRACT_PAYMENTSERVICE_HASH=0x8e34688c49d4af4236c2ae3bdf9898e1e5710373
