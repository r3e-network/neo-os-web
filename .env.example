CONTRACT_MINIAPP_SECRETVOTE_HASH=
CONTRACT_MINIAPP_SECRETPOKER_HASH=
CONTRACT_MINIAPP_MICROPREDICT_HASH=
CONTRACT_MINIAPP_REDENVELOPE_HASH=
CONTRACT_MINIAPP_GASCIRCLE_HASH=
# Phase 3 - Advanced
CONTRACT_MINIAPP_FOGCHESS_HASH=
CONTRACT_MINIAPP_GOVBOOSTER_HASH=
CONTRACT_MINIAPP_TURBOOPTIONS_HASH=
CONTRACT_MINIAPP_ILGUARD_HASH=
CONTRACT_MINIAPP_GUARDIANPOLICY_HASH=
# Phase 4 - Long-Running
CONTRACT_MINIAPP_AITRADER_HASH=
CONTRACT_MINIAPP_GRIDBOT_HASH=
CONTRACT_MINIAPP_NFTEVOLVE_HASH=
CONTRACT_MINIAPP_BRIDGEGUARDIAN_HASH=

# Fairy RPC for local testing
FAIRY_RPC_URL=http://127.0.0.1:16868

# =============================================================================
# Service routing (Supabase Edge + internal mesh)
# =============================================================================
# These are the service URLs the Supabase Edge functions call. In production you
# should use HTTPS + mTLS with AWS Nitro/attested TLS.
#
# Local development options:
# - When the services run in Docker Compose: use `http://<service-name>:<port>` (default below).
# - When using the local Edge dev server on the host (`make edge-dev`): use `http://localhost:<port>`
#   (simulation compose exposes these ports on 127.0.0.1).
#
# Latest Morpheus architecture uses a unified public runtime endpoint.
# MORPHEUS_RUNTIME_URL=https://oracle.meshmini.app/testnet
# MORPHEUS_RUNTIME_TOKEN=
# PHALA_API_TOKEN=
# PHALA_SHARED_SECRET=
# MORPHEUS_PUBLIC_API_URL=https://oracle.meshmini.app/testnet
# MORPHEUS_EDGE_URL=https://edge.meshmini.app/testnet
# MORPHEUS_CONTROL_PLANE_URL=https://control.meshmini.app
NEOFLOW_URL=http://neoflow:8084
TXPROXY_URL=http://txproxy:8090
# TxProxy client timeout (Go duration). Increase if waiting for confirmations.
TXPROXY_TIMEOUT=90s
# GasBank service URL (optional; enables fee deduction for services).
GASBANK_URL=http://neogasbank:8091
# Account pool service URL (used by GasBank/Simulation).
NEOACCOUNTS_SERVICE_URL=http://neoaccounts:8085
# NeoRequests dispatcher controls (optional)
NEOREQUESTS_MAX_RESULT_BYTES=800
NEOREQUESTS_MAX_ERROR_LEN=256
# NEOREQUESTS_ENFORCE_APPREGISTRY=true
# NEOREQUESTS_APPREGISTRY_CACHE_SECONDS=60
# NEOREQUESTS_RNG_RESULT_MODE=raw
# NEOREQUESTS_TX_WAIT=true
# NEOREQUESTS_ONCHAIN_USAGE=false
# NEOREQUESTS_TX_USAGE=true
# NEOREQUESTS_REQUIRE_MANIFEST_CONTRACT=true
# NEOREQUESTS_STATS_ROLLUP_INTERVAL=30m
# ServiceGateway stuck-request recovery script controls (optional)
# GATEWAY_RECOVERY_REQUEST_ID=105
# GATEWAY_RECOVERY_ERROR=manual recovery
# GATEWAY_RECOVERY_TIMEOUT=2m
# GATEWAY_RECOVERY_DRY_RUN=false
# NEO_EVENT_LISTEN_ALL=true
# NEO_EVENT_CONFIRMATIONS=0
# NEO_EVENT_BACKFILL_BLOCKS=0
# NEO_EVENT_START_BLOCK=0
# NeoFeeds publish policy controls (optional)
# NEOFEEDS_UPDATE_INTERVAL=1s
# NEOFEEDS_PUBLISH_THRESHOLD_BPS=10
# NEOFEEDS_PUBLISH_HYSTERESIS_BPS=8
# NEOFEEDS_PUBLISH_MIN_INTERVAL=1s
# NEOFEEDS_PUBLISH_MAX_PER_MINUTE=120
# Optional heartbeat anchor interval for low-volatility feeds (0 disables).
# NEOFEEDS_PUBLISH_HEARTBEAT_INTERVAL=15m
# GasBank deposit address (public)
GASBANK_DEPOSIT_ADDRESS=
# Optional: enable automatic pool account top-ups via NeoAccounts /fund.
# TOPUP_ENABLED=true

# AccountPool persistence controls
# Allow ephemeral master key only for local experiments (accounts unrecoverable).
NEOACCOUNTS_ALLOW_EPHEMERAL_MASTER_KEY=false
# Delete retiring accounts once balances reach zero (default: keep for audit).
NEOACCOUNTS_DELETE_RETIRING_ACCOUNTS=false

# =============================================================================
# Supabase Edge (Gateway) rate limiting
# =============================================================================
# The gateway implements fixed-window rate limiting backed by the Postgres
# `rate_limits` table and the `rate_limit_bump(...)` RPC.
#
# Global defaults:
# EDGE_RATELIMIT_DEFAULT_PER_MINUTE=60
# EDGE_RATELIMIT_WINDOW_SECONDS=60
#
# Per-endpoint overrides use the Edge function name uppercased with hyphens
# replaced by underscores:
# EDGE_RATELIMIT_PAY_GAS_PER_MINUTE=10
# EDGE_RATELIMIT_VOTE_NEO_PER_MINUTE=10

# =============================================================================
# Platform (Host App + Admin Console)
# =============================================================================
# Comma-separated Edge function names that /api/rpc/* is allowed to call.
# Use "*" to allow all (legacy open-proxy behavior).
EDGE_RPC_ALLOWLIST=

# Admin console API key (required by admin API routes).
ADMIN_CONSOLE_API_KEY=
# Optional alias:
# ADMIN_API_KEY=
# Optional: expose admin key to browser (admin console).
# NEXT_PUBLIC_ADMIN_CONSOLE_API_KEY=
# NEXT_PUBLIC_ADMIN_API_KEY=

# Host app admin/write API key for protected `/api/miniapps/admin/*` routes.
MINIAPP_ADMIN_API_KEY=
# Publish workflow controls.
MINIAPP_PUBLISH_APPROVAL_REQUIRED=true
# Reviewer list (comma-separated emails/wallet labels) for approval mode.
MINIAPP_PUBLISH_REVIEWERS=
# Optional fallback admin wallets (comma-separated addresses).
MINIAPP_ADMIN_WALLETS=
MINIAPP_PUBLISH_APPROVAL_SLA_MINUTES=60
MINIAPP_PUBLISH_APPROVAL_ESCALATION_MINUTES=180
# Optional webhook for approval reminders/escalations.
MINIAPP_PUBLISH_REMINDER_WEBHOOK_URL=
# Secret required for cron APIs.
CRON_SECRET=
# Canonical public base URLs used by host/admin cross-links and webhooks.
HOST_APP_BASE_URL=http://localhost:3000
MINIAPP_HOST_APP_BASE_URL=http://localhost:3000

# Required for browser clients that call Supabase Edge Functions directly.
# Comma/space-separated exact origins; do not use Markdown links or trailing slashes.
# When unset, Edge functions intentionally reject cross-origin preflight requests.
# EDGE_CORS_ORIGINS=http://localhost:3000 https://neomini.app

# Optional: MiniApp usage tracking mode for Edge cap enforcement.
# - record (default): increments `miniapp_usage` via `miniapp_usage_bump(...)`.
# - check: enforces caps via `miniapp_usage_check(...)` without recording usage.
# MINIAPP_USAGE_MODE=record
# Optional per-intent overrides:
# MINIAPP_USAGE_MODE_PAYMENTS=check
# MINIAPP_USAGE_MODE_GOVERNANCE=record

# Optional: service-to-service signer routing (preferred over distributing keys).
# When set, services (except `globalsigner`) will delegate signing to GlobalSigner.
# GLOBALSIGNER_SERVICE_URL=https://globalsigner:8092

# Optional: chain event listener start height (defaults to current height-1).
# NEO_EVENT_START_BLOCK=0
# Optional: listen to all contract notifications (enables MiniApp event indexing).
# Defaults to true for `neorequests` when unset.
# NEO_EVENT_LISTEN_ALL=true

# Oracle outbound URL allowlist (comma-separated prefixes)
# Required in production/strict TEE mode. Examples:
# ORACLE_HTTP_ALLOWLIST=https://api.binance.com,https://api.coinbase.com
ORACLE_HTTP_ALLOWLIST=https://api.binance.com,https://api.coinbase.com

# NeoOracle request controls (optional)
# - ORACLE_TIMEOUT: Go duration (e.g. 20s, 1m)
# - ORACLE_MAX_SIZE: max response size in bytes (supports KiB/MiB/GiB suffixes)
ORACLE_TIMEOUT=20s
ORACLE_MAX_SIZE=2MiB

# NeoCompute execution result retention (optional; default 24h)
# NEOCOMPUTE_RESULT_TTL=24h

# TxProxy allowlist (JSON). Default is deny-all when unset.
# Method names must match Neo devpack manifest names (lowerCamelCase).
# Minimal platform allowlist example:
# TXPROXY_ALLOWLIST='{"contracts":{"<paymentHubHash>":["pay"],"<governanceHash>":["stake","unstake","vote"],"<priceFeedHash>":["update"],"<randomnessLogHash>":["record"],"<automationAnchorHash>":["markExecuted"],"<serviceGatewayHash>":["fulfillRequest"]}}'
# For automation target contracts, add them explicitly (or use "*" per contract, not recommended).
TXPROXY_ALLOWLIST=

# NeoFlow webhook security (production/strict TEE)
# External webhooks are blocked from targeting private/loopback/link-local networks by default.
# Set to true only if you need to call private endpoints (not recommended).
NEOFLOW_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# NeoFlow scheduler hydration (optional)
# If set, the scheduler will hydrate Supabase triggers for this user ID on startup.
# (Intended to be injected via AWS Nitro secrets in production.)
# NEOFLOW_SCHEDULER_USER_ID=

# AutomationAnchor anchored tasks (optional)
# Comma-separated task IDs to load from the on-chain `AutomationAnchor` registry.
# Each entry can be either:
# - plain ASCII (stored as bytes), or
# - hex bytes (0x...).
NEOFLOW_TASK_IDS=

# Simulation service (optional)
# SIMULATION_ENABLED=true
# SIMULATION_MINIAPPS=miniapp-lottery,miniapp-coinflip,miniapp-dicegame
# SIMULATION_TX_INTERVAL_MIN_MS=1000
# SIMULATION_TX_INTERVAL_MAX_MS=5000
# SIMULATION_WORKERS_PER_APP=2

# Binance API
BINANCE_API_KEY=your_binance_api_key_here

# Arbitrum RPC for Chainlink price feeds
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# =============================================================================
# Development-only signing keys (fallback)
# =============================================================================
# In production, use GlobalSigner (`GLOBALSIGNER_SERVICE_URL`) rather than
# distributing private keys to every enclave service.
#
# TEE_PRIVATE_KEY=hex_private_key_for_chain_signing
# TEE_WALLET_PRIVATE_KEY=hex_private_key_for_wallet_operations

# =============================================================================
# AWS Nitro-injected identity & secrets (do not set manually)
# =============================================================================
# These are injected by AWS Nitro/runtime integration and are shown here for
# completeness and local debugging.
#
# NITRO_CERT=
# NITRO_KEY=
# NITRO_ROOT_CA=
# NITRO_EXTRA_CLIENT_CA=
# NITRO_UUID=
# NITRO_SECRETS=

# =============================================================================
# Supabase Edge → TEE mTLS (optional)
# =============================================================================
# Edge functions will use mTLS when these PEM values are set.
#
# TEE_MTLS_CERT_PEM=
# TEE_MTLS_KEY_PEM=
# TEE_MTLS_ROOT_CA_PEM=
#
# Alternatively:
# NITRO_ROOT_CA_PEM=
#
# RNG anchoring (optional): set to 1 to record RNG results on-chain via txproxy.
# RNG_ANCHOR=1

# =============================================================================
# Host App (Next.js) security configuration
# =============================================================================
# Space-separated list of allowed origins for embedded MiniApps (iframe frame-src).
# Example: "https://cdn.miniapps.com https://trusted-apps.miniapps.com"
# MINIAPP_FRAME_ORIGINS=

# ------------------------------------------------------------------------------
# Host App: Cloudflare R2 Media Upload (No-Code MiniApp Assets)
# ------------------------------------------------------------------------------
# MINIAPP_R2_ACCOUNT_ID=bf0d7e814f69945157f30505e9fba9fe
# MINIAPP_R2_BUCKET=miniapps
# MINIAPP_R2_ACCESS_KEY_ID=
# MINIAPP_R2_SECRET_ACCESS_KEY=
# MINIAPP_MEDIA_PUBLIC_BASE_URL=https://meshmini.app
# MINIAPP_R2_SIGNED_URL_EXPIRES_SECONDS=900
#
# Module Federation remotes for platform MiniApps (comma-separated).
# Example: NEXT_PUBLIC_MF_REMOTES=miniapp@https://cdn.miniapps.com/miniapps/miniapp-mf
# MiniApp manifests can use: mf://manifest?app=<app_id>
# NEXT_PUBLIC_MF_REMOTES=
#
# Used for CSP connect-src; typically your Supabase project URL.
# Already defined above in the Supabase section as NEXT_PUBLIC_SUPABASE_URL.

# =============================================================================
# SaaS Integrations (Optional)
# =============================================================================
# Sentry error reporting (leave blank to disable).
# Also set in platform/host-app/.env.example for host-only context.
NEXT_PUBLIC_SENTRY_DSN=
# PostHog product analytics (leave blank to disable).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional: Host-side /api/rpc/* proxy target (see platform/host-app/README.md).
# Prefer setting to the functions base URL:
# EDGE_BASE_URL=https://your-project.supabase.co/functions/v1
# EDGE_BASE_URL=http://localhost:8787/functions/v1
