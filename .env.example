CONTRACT_CHECKINSERVICE_HASH=0x129ccc9480e8adc3bc157c9cb80c64df725801cf
CONTRACT_BADGESERVICE_HASH=0x9a99d732a9e5aaebcd7fd1bdc928eb2b31868499
CONTRACT_LEADERBOARDSERVICE_HASH=0xfc71e7ce9a695bb3f30a045847d046867e56aa97
CONTRACT_VESTINGSERVICE_HASH=0x3ccfa738bb71c7331fae306aa16529718d6ad742
CONTRACT_GAMESERVICE_HASH=0x1ca3392195c684dfd86ab324ebcd63d11d09daa9
CONTRACT_ESCROWSERVICE_HASH=0x6b283ad470535cd9023a67ae479040f775b4b7d8
CONTRACT_NFTSERVICE_HASH=0xa55ba1e0cc79efcc93f637ac6a5b2935ceed4f90
# Optional: sample MiniApp consumer contract for callback validation scripts.
CONTRACT_MINIAPP_CONSUMER_HASH=

# =============================================================================
