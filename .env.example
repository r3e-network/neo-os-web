# CONTRACT_RECIPEREGISTRY_HASH=0x...
# CONTRACT_MINIAPPINSTANCEREGISTRY_HASH=0x...
# CONTRACT_SERVICEGATEWAY_HASH=0x...
CONTRACT_FUNDINGVAULT_HASH=0x0000000000000000000000000000000000000000
CONTRACT_STREAMVESTING_HASH=0x0000000000000000000000000000000000000000
CONTRACT_AUTOMATIONANCHOR_HASH=0x0000000000000000000000000000000000000000
